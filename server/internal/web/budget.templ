package web

import (
	"fmt"

	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/web/components/button"
	"github.com/henriquepw/prata/server/internal/web/components/field"
	"github.com/henriquepw/prata/server/internal/web/components/input"
	"github.com/henriquepw/prata/server/internal/web/shared"
	"github.com/henriquepw/prata/server/internal/web/utils"
)

// budgetScript recalculates the division on the Categorias screen at each input, as the server would: the active
// mode's fields are the division, the other mode, the sliders, the bar, the status line and "> salvar divisão" follow
// from them. Changing the mode copies the division into the other fields; changing the Receita mensal keeps the
// percentages in percent and the values in value. The server checks everything again on POST /budget.
templ budgetScript() {
	<script>
		(() => {
		  const cents = (d, s) => { const n = Number(s.trim().split(d.thousands).join('').replace(d.decimal, '.')); return isNaN(n) || n < 0 ? 0 : Math.round(n * 100) }
		  const amount = (d, n) => { const w = String(Math.trunc(n / 100)).replace(/\B(?=(\d{3})+$)/g, d.thousands); return w + d.decimal + String(n % 100).padStart(2, '0') }
		  const money = (d, n) => (n < 0 ? '−' : '') + d.symbol + ' ' + amount(d, Math.abs(n))
		  const points = (n, total) => total ? Math.floor((n * 20000 + total) / (2 * total)) : 0
		  addEventListener('input', e => {
		    const f = e.target.closest('form[data-budget]')
		    if (!f) return
		    const d = f.dataset, percent = !f.querySelector('[name=mode][value=value]')?.checked, income = cents(d, f.elements.income.value)
		    const rows = [...f.querySelectorAll('[data-row]')]
		    let gapCents = income, gapPoints = 10000
		    f.dataset.mode = percent ? 'percent' : 'value'
		    f.querySelector('[data-hint]').textContent = percent ? d.hintPercent : d.hintValue
		    for (const row of rows) {
		      const p = row.querySelector('[data-percent]'), v = row.querySelector('[data-value]'), range = row.querySelector('[type=range]')
		      if (e.target === range) (percent ? p : v).value = amount(d, percent ? Math.round(range.value * 100) : Math.round(income * range.value / 100))
		      const typed = e.target.name === 'mode' ? !percent : percent
		      const c = typed ? Math.trunc(income * cents(d, p.value) / 10000) : cents(d, v.value), pt = typed ? cents(d, p.value) : points(c, income)
		      if (e.target.name === 'mode') (percent ? p : v).value = amount(d, percent ? pt : c)
		      p.disabled = !percent; v.disabled = percent
		      if (e.target !== range) range.value = pt / 100
		      range.style.setProperty('--p', Math.min(100, Math.max(0, pt / 100)) + '%')
		      row.querySelector('[data-derived]').textContent = percent ? money(d, c) : amount(d, pt) + '%'
		      f.querySelector('[data-slice="' + row.dataset.row + '"]').style.width = Math.max(0, pt / 100) + '%'
		      gapCents -= c; gapPoints -= pt
		    }
		    if (percent) gapCents = Math.trunc(income * gapPoints / 10000)
		    else gapPoints = Math.sign(gapCents) * points(Math.abs(gapCents), income)
		    const gap = percent ? gapPoints : gapCents, closed = income > 0 && (!rows.length || gap === 0), status = f.querySelector('[data-status]')
		    f.querySelector('[data-slice=free]')?.style.setProperty('width', Math.max(0, gapPoints / 100) + '%')
		    f.classList.toggle('over', rows.length > 0 && gap < 0)
		    f.classList.toggle('closed', rows.length > 0 && closed)
		    if (status) status.textContent = !income || !rows.length ? '' : closed ? d.closed : (gap > 0 ? d.missing : d.over) + ' ' + money(d, Math.abs(gapCents)) + ' · ' + amount(d, Math.abs(gapPoints)) + '%'
		    f.querySelector('[type=submit]').disabled = !closed
		  })
		})()
	</script>
}

// budgetInput is a bare input of the division, with the block caret.
const budgetInput = "min-w-0 bg-transparent tabular-nums caret-primary [caret-shape:block] outline-none"

// budgetField is a category's limit field: an underline that turns primary on focus and destructive on error.
const budgetField = "border-b border-line text-right transition-colors focus:border-primary aria-invalid:border-destructive"

// budgetName is a category's name opening its sheet, inverted on hover and focus.
const budgetName = "cursor-pointer justify-self-start px-0.5 text-left " + inverted + " focus-visible:bg-foreground focus-visible:text-background"

// budgetSlice is a slice of the 100% bar, its width set by the server and the script.
const budgetSlice = "block bg-current transition-all duration-(--move)"

// budgetScreen is the Categorias screen: the Receita mensal panel, with its prompt, the 100% bar and the line that
// says what is missing or exceeds, and the Categorias panel, with a row per category (its name opening its sheet, a
// slider, the field in the typed mode and the value in the other) and "> salvar divisão". Without a Receita mensal it
// asks for it first: no bar, slider nor limit field, and the stored division goes along hidden, in percent, until a
// typed one above zero comes back in a 422. flash is the category a sheet just saved.
templ budgetScreen(form budgetForm, flash string) {
	{{ hasIncome := form.Welcome || form.income > 0 || shared.SessionFrom(ctx).MonthlyIncome > 0 }}
	{{ format, _ := shared.Find(shared.NumberFormats, shared.SessionFrom(ctx).NumberFormat) }}
	@input.MoneyScript()
	<form
		id="budget"
		{ utils.IfElse(form.Welcome, templ.Attributes{"method": "post", "action": "/welcome"}, templ.Attributes{"hx-post": "/budget", "hx-target": "this", "hx-swap": "outerHTML", "hx-disable": "find [type=submit]"})... }
		class={ "flex flex-col gap-5", templ.KV("over", hasIncome && !form.closed() && form.gapSign() < 0), templ.KV("closed", form.closed()) }
		data-budget
		data-mode={ form.Mode }
		data-decimal={ format.Decimal }
		data-thousands={ format.Thousands }
		data-symbol={ shared.CurrencySymbol(ctx) }
		data-missing={ i18n.T(ctx, "budget.missing") }
		data-over={ i18n.T(ctx, "budget.over") }
		data-closed={ i18n.T(ctx, "budget.closed") }
		data-hint-percent={ i18n.T(ctx, "budget.hint_percent") }
		data-hint-value={ i18n.T(ctx, "budget.hint_value") }
	>
		@panel(i18n.T(ctx, "budget.title"), "", nil) {
			<label class="flex items-center gap-2 border-b border-line pb-1 text-base transition-colors focus-within:border-primary">
				<span class="text-primary" aria-hidden="true">&gt;</span>
				<span class="text-xs text-muted-foreground">{ shared.CurrencySymbol(ctx) }</span>
				<input
					id="income"
					class={ budgetInput, "flex-1" }
					name="income"
					value={ form.Income }
					placeholder={ shared.Amount(ctx, 0) }
					aria-label={ i18n.T(ctx, "budget.title") }
					inputmode="numeric"
					data-mask="money"
					autocomplete="off"
					autofocus?={ !hasIncome }
					{ ariaInvalid(form.Errors["income"])... }
				/>
			</label>
			@fieldNote(utils.IfElse(hasIncome, "", i18n.T(ctx, "budget.income_first")), form.Errors["income"])
			if hasIncome {
				<p class="mt-1 text-2xs text-muted-foreground" data-hint>{ i18n.T(ctx, utils.IfElse(form.percent(), "budget.hint_percent", "budget.hint_value")) }</p>
				<div class="mt-5 flex h-6 gap-0.5 bg-line-faint" aria-hidden="true">
					for _, category := range form.Categories {
						<i class={ budgetSlice, colorClass(category.Color) } data-slice={ category.ID } title={ category.Name } style={ width(form.Points[category.ID]) }></i>
					}
					{{ _, free := form.gap() }}
					<i class={ budgetSlice, "budget-free" } data-slice="free" title={ i18n.T(ctx, "budget.free") } style={ width(free) }></i>
				</div>
				<div class="mt-1 flex justify-between gap-4 text-xs tabular-nums">
					@budgetStatus(form)
					<span class="text-muted-foreground">100%</span>
				</div>
			} else {
				<p class="sr-only" data-hint></p>
			}
		}
		{ children... }
		@panel(i18n.T(ctx, "nav.categories"), "", budgetActions(form, hasIncome)) {
			if len(form.Categories) == 0 {
				@empty(i18n.T(ctx, "categories.empty"))
			}
			<div class="grid grid-cols-[auto_1fr_auto_--spacing(30)] items-center gap-x-4 gap-y-3 text-sm @max-2xl/console:grid-flow-row-dense @max-2xl/console:grid-cols-[1fr_auto_auto] @max-2xl/console:gap-x-2 @max-2xl/console:gap-y-1.5">
				for _, category := range form.Categories {
					if hasIncome {
						@budgetRow(form, category.ID, category.Name, category.Color, category.ID == flash)
					} else {
						<button type="button" class={ budgetName } hx-get={ "/categories/" + category.ID } hx-target="#sheet" data-flash?={ category.ID == flash }>
							@categoryName(category.Name, category.Color)
						</button>
						<input type="hidden" name={ "limit_" + category.ID } value={ form.Percents[category.ID] }/>
					}
				}
			</div>
			if form.Errors["form"] != "" {
				@field.Error() {
					{ form.Errors["form"] }
				}
			}
			<footer class="mt-5 flex justify-end">
				@button.Button(button.Props{Type: button.TypeSubmit, Disabled: !form.closed(), Attributes: templ.Attributes{"data-busy": i18n.T(ctx, "form.saving")}}) {
					<span>&gt; { i18n.T(ctx, "budget.save") }</span>
				}
			</footer>
		}
	</form>
}

// budgetRow is a category's row in the division: its name, the slider, the field in each mode (the inactive one
// hidden and disabled, so only the typed mode is sent) and the value in the other mode.
templ budgetRow(form budgetForm, id, name, color string, flash bool) {
	<div class="contents" data-row={ id }>
		if form.Welcome {
			<span class="px-0.5">
				@categoryName(name, color)
			</span>
		} else {
			<button type="button" class={ budgetName } hx-get={ "/categories/" + id } hx-target="#sheet" data-flash?={ flash }>
				@categoryName(name, color)
			</button>
		}
		<input
			type="range"
			min="0"
			max="100"
			step="0.5"
			value={ fmt.Sprintf("%.2f", float64(form.Points[id])/100) }
			aria-label={ i18n.T(ctx, "budget.in_percent", name) }
			class={ "budget-range h-6 w-full min-w-34 cursor-ew-resize appearance-none bg-transparent focus-visible:outline focus-visible:outline-offset-3 focus-visible:outline-primary in-[.over]:text-destructive @max-2xl/console:col-span-full", colorClass(color) }
			style={ templ.SafeCSS(fmt.Sprintf("--p: %.2f%%", min(100, max(0, float64(form.Points[id])/100)))) }
		/>
		<span class="flex justify-end">
			<span class="in-data-[mode=value]:hidden">
				<input
					name={ "limit_" + id }
					value={ form.Percents[id] }
					placeholder={ shared.Amount(ctx, 0) }
					aria-label={ i18n.T(ctx, "budget.in_percent", name) }
					inputmode="decimal"
					autocomplete="off"
					disabled?={ !form.percent() }
					class={ budgetInput, budgetField, "w-15" }
					data-percent
					{ ariaInvalid(utils.IfElse(form.percent(), form.Errors["limit_"+id], ""))... }
				/>
				<span aria-hidden="true">%</span>
			</span>
			<span class="in-data-[mode=percent]:hidden">
				<input
					name={ "limit_" + id }
					value={ form.Values[id] }
					placeholder={ shared.Amount(ctx, 0) }
					aria-label={ i18n.T(ctx, "budget.in_value", name) }
					inputmode="numeric"
					data-mask="money"
					autocomplete="off"
					disabled?={ form.percent() }
					class={ budgetInput, budgetField, "w-25" }
					data-value
					{ ariaInvalid(utils.IfElse(form.percent(), "", form.Errors["limit_"+id]))... }
				/>
			</span>
		</span>
		<span class="text-right text-muted-foreground tabular-nums" data-derived>
			if form.percent() {
				{ shared.Money(ctx, form.Cents[id]) }
			} else {
				{ shared.Amount(ctx, form.Points[id]) }%
			}
		</span>
		if message := form.Errors["limit_"+id]; message != "" {
			<div class="col-span-full">
				@fieldNote("", message)
			</div>
		}
	</div>
}

// budgetActions is the Categorias panel's "editar em [valor] [%]", only while there is a Receita mensal to divide,
// and its "+ nova [n]".
templ budgetActions(form budgetForm, hasIncome bool) {
	<span class="flex flex-wrap items-center justify-end gap-4">
		if hasIncome {
			<span class="flex items-center gap-2">
				<span id="mode-label" class="text-2xs uppercase tracking-widest text-muted-foreground">{ i18n.T(ctx, "budget.mode") }</span>
				<span role="radiogroup" aria-labelledby="mode-label" class={ choiceGroup }>
					@choiceOption("mode", budgetInValue, !form.percent()) {
						{ i18n.T(ctx, "budget.mode_value") }
					}
					@choiceOption("mode", budgetInPercent, form.percent()) {
						%
					}
				</span>
			</span>
		} else {
			<input type="hidden" name="mode" value={ budgetInPercent }/>
		}
		if !form.Welcome {
			@newAction("/categories/new")
		}
	</span>
}

// budgetStatus is the line under the bar: what is missing to close the Receita mensal, what exceeds it, in
// destructive, or "fechado em 100%".
templ budgetStatus(form budgetForm) {
	{{ cents, points := form.gap() }}
	<span class="text-muted-foreground in-[.closed]:text-cat-green in-[.over]:text-destructive" role="status" data-status>
		switch  {
			case form.closed():
				{ i18n.T(ctx, "budget.closed") }
			case form.income <= 0:
			default:
				{ i18n.T(ctx, utils.IfElse(form.gapSign() > 0, "budget.missing", "budget.over")) } { shared.Money(ctx, abs(cents)) } · { shared.Amount(ctx, abs(points)) }%
		}
	</span>
}
