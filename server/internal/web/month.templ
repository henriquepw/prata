package web

import (
	"context"
	"strconv"
	"strings"
	"time"

	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/badge"
	"github.com/henriquepw/prata/server/internal/web/components/button"
	"github.com/henriquepw/prata/server/internal/web/components/input"
	"github.com/henriquepw/prata/server/internal/web/components/nativeselect"
	"github.com/henriquepw/prata/server/internal/web/components/table"
	"github.com/henriquepw/prata/server/internal/web/utils"
)

const meterSegments = 20

// meter is the class of each of the 20 segments of a category's usage: the used share of the limit in the category's
// color and, past the limit, the limit's share in color (19 at most) and the excess "over"; all empty without a limit.
func meter(usage store.CategoryUsage) []string {
	segments := make([]string, meterSegments)
	if usage.MonthlyLimit == 0 {
		return segments
	}

	isOver := usage.Used > usage.MonthlyLimit
	on := (usage.Used*meterSegments + usage.MonthlyLimit/2) / usage.MonthlyLimit
	if isOver {
		on = min(meterSegments-1, (usage.MonthlyLimit*meterSegments+usage.Used/2)/usage.Used)
	}

	for i := range segments {
		switch {
		case int64(i) < on:
			segments[i] = colorClass(usage.Color)
		case isOver:
			segments[i] = "over"
		}
	}

	return segments
}

// percent is the rounded share of the limit a category used, or "∞" without a limit.
func percent(usage store.CategoryUsage) string {
	if usage.MonthlyLimit == 0 {
		return "∞"
	}

	return strconv.FormatInt((usage.Used*100+usage.MonthlyLimit/2)/usage.MonthlyLimit, 10) + "%"
}

// tightTable narrows a wide table's cell padding on mobile, spelled out here for Tailwind.
const tightTable = "@max-[640px]:[&_:is(td,th)]:px-1"

// shortDay writes a pure "YYYY-MM-DD" date without the year in the request's Formato de data, as "19/11".
func shortDay(ctx context.Context, date string) string {
	t, _ := time.Parse(time.DateOnly, date)

	return t.Format(strings.Trim(strings.ReplaceAll(dateLayout(ctx), "2006", ""), "/-"))
}

// monthURL is the Mês of month, as YYYY-MM, with the statement narrowed to category when it is not empty.
func monthURL(month, category string) string {
	if category == "" {
		return "/?month=" + month
	}

	return "/?month=" + month + "&category=" + category
}

// monthOffset is month offset months away, as YYYY-MM.
func monthOffset(month time.Time, offset int) string {
	return month.AddDate(0, offset, 0).Format(monthLayout)
}

// monthPage is the Mês: the month bar over the boxes and the statement, which a confirmation on a row swaps.
templ monthPage(s shell, page month) {
	@layout(s) {
		@monthBar(page)
		@monthContent(page)
	}
}

// monthSwap is the answer of a write in place: the month, with the ticker and the balance line out of band.
templ monthSwap(s shell, page month) {
	@monthContent(page)
	@ticker(s, true)
	@balanceLine(s.Balance, true)
}

// monthBar is "‹ novembro de 2026 ›", with "[mês atual]" away from it and the [ ] keys on the right.
templ monthBar(page month) {
	<div class="month-bar">
		<div class="flex items-center gap-[1ch]">
			<a href={ templ.SafeURL(monthURL(monthOffset(page.Month, -1), page.Filter.ID)) } class="lnk" data-key="[" aria-label={ i18n.T(ctx, "month.previous") }>‹</a>
			<span class="month-label">{ i18n.T(ctx, "month.year", i18n.T(ctx, "month."+page.Month.Month().String()), page.Month.Year()) }</span>
			<a href={ templ.SafeURL(monthURL(monthOffset(page.Month, 1), page.Filter.ID)) } class="lnk" data-key="]" aria-label={ i18n.T(ctx, "month.next") }>›</a>
			if !page.isCurrent() {
				<a href={ templ.SafeURL(monthURL(page.Today[:len(monthLayout)], page.Filter.ID)) } class="lnk">{ i18n.T(ctx, "month.current") }</a>
			}
		</div>
		<span class="month-keys hide-m"><kbd>[</kbd> <kbd>]</kbd> { i18n.T(ctx, "month.switch") }</span>
	</div>
}

// monthContent is the six boxes of the month's account and the grid of the statement and the categories.
templ monthContent(page month) {
	<div id="month" class="month">
		if page.Error != "" {
			<p role="alert" class="text-destructive">! { page.Error }</p>
		}
		<div class="kpis">
			@kpi(i18n.T(ctx, "month.previous_balance"), page.Previous)
			@kpi(i18n.T(ctx, "month.income"), page.Income)
			@kpi(i18n.T(ctx, "month.outcome"), -page.Outcome)
			@kpi(i18n.T(ctx, "month.realized"), page.realized())
			@kpi(i18n.T(ctx, "month.pending"), page.Pending)
			@kpi(i18n.T(ctx, "month.projected"), page.realized()+page.Pending)
		</div>
		@launchPanel(page)
		<div class="split">
			@panel(i18n.T(ctx, "month.statement"), "", statementActions(page)) {
				if len(page.Days) == 0 && len(page.Overdue) == 0 {
					@empty(i18n.T(ctx, utils.IfElse(page.Filter.ID == "", "month.empty", "month.empty_category")))
				} else {
					@table.Table(table.Props{Class: tightTable}) {
						@table.Body() {
							for i, d := range page.Days {
								if i == page.TodayAt {
									@todayLine(page)
								}
								<tr class="statement-day">
									<td colspan="3">{ i18n.T(ctx, "weekday."+dayOf(d.Date).Weekday().String()) } { shortDay(ctx, d.Date) }</td>
									<td class="text-right tabular-nums">
										if len(d.Transactions) > 0 {
											{ money(ctx, d.Total) }
										}
									</td>
								</tr>
								for _, p := range d.Pending {
									@pendingRow(page, p, false)
								}
								for _, t := range d.Transactions {
									@table.Row(sheetRow("/transactions/"+t.ID, t.ID == page.Flash)) {
										@table.Cell(table.CellProps{Class: "w-full whitespace-normal"}) {
											@description(t.Description)
										}
										@table.Cell(table.CellProps{Class: "hide-m"}) {
											@categoryName(t.CategoryName, t.CategoryColor)
										}
										@table.Cell(table.CellProps{Class: "hide-m text-muted-foreground"}) {
											if t.TagName != "" {
												{ "#" + t.TagName }
											}
										}
										@table.Cell(table.CellProps{Class: utils.CN("text-right tabular-nums", kindClass(t.Kind))}) {
											{ money(ctx, signed(t.Kind, t.Amount)) }
										}
									}
								}
							}
							if page.TodayAt == len(page.Days) {
								@todayLine(page)
							}
						}
					}
				}
			}
			@panel(i18n.T(ctx, "nav.categories"), "", allCategories(page)) {
				if len(page.Usages) == 0 {
					@empty(i18n.T(ctx, "categories.empty"))
				} else {
					<div class="usages">
						for _, usage := range page.Usages {
							{{ isOver := usage.MonthlyLimit > 0 && usage.Used > usage.MonthlyLimit }}
							<a
								href={ templ.SafeURL(monthURL(page.Month.Format(monthLayout), usage.ID)) }
								class="usage"
								if usage.ID == page.Filter.ID {
									aria-current="true"
								}
							>
								@categoryName(usage.Name, usage.Color)
								<b class={ "text-xs tabular-nums", templ.KV("text-destructive", isOver), templ.KV("text-muted-foreground", !isOver) }>{ percent(usage) }</b>
								<span class="meter" aria-hidden="true">
									for _, segment := range meter(usage) {
										<i class={ segment }></i>
									}
								</span>
							</a>
						}
					</div>
				}
			}
		</div>
	</div>
}

// statementActions is the statement's filter, "■ mercado ✕", which clears it, and "+ nova".
templ statementActions(page month) {
	<span class="flex items-center gap-[1ch]">
		if page.Filter.ID != "" {
			<a href={ templ.SafeURL(monthURL(page.Month.Format(monthLayout), "")) } class="lnk flex items-center gap-[1ch]">
				@categoryName(page.Filter.Name, page.Filter.Color)
				✕
			</a>
		}
		@newAction("/transactions/new")
	</span>
}

// allCategories is "[todas]", which clears the filter, only while there is one.
templ allCategories(page month) {
	if page.Filter.ID != "" {
		<a href={ templ.SafeURL(monthURL(page.Month.Format(monthLayout), "")) } class="lnk">{ i18n.T(ctx, "month.all") }</a>
	}
}

// dayOf is a pure "YYYY-MM-DD" date at midnight UTC.
func dayOf(date string) time.Time {
	t, _ := time.Parse(time.DateOnly, date)

	return t
}

// todayLine is "── hoje · 19/11 ──", with the overdue occurrences of earlier months under it.
templ todayLine(page month) {
	<tr class="statement-today">
		<td colspan="4">── { i18n.T(ctx, "month.today") } · { shortDay(ctx, page.Today) } ──</td>
	</tr>
	for _, p := range page.Overdue {
		@pendingRow(page, p, true)
	}
}

// pendingRow is a pending occurrence in the statement, with its date when withDate: muted, its [pendente] or
// [atrasada] chip and "confirmar", which swaps the month in place. The row itself opens "confirmar ocorrência".
templ pendingRow(page month, p occurrence, withDate bool) {
	{{ url := "/recurrences/" + p.Recurrence.ID + "/occurrences/" + p.Date }}
	@table.Row(table.RowProps{Class: "statement-pending", Attributes: sheetRow(url, false).Attributes}) {
		@table.Cell(table.CellProps{Class: "w-full whitespace-normal"}) {
			if withDate {
				<span class="tabular-nums">{ shortDay(ctx, p.Date) }</span>
			}
			@description(p.Recurrence.Description)
			if p.Overdue {
				@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
					{ i18n.T(ctx, "month.overdue") }
				}
			} else {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					{ i18n.T(ctx, "month.pending_chip") }
				}
			}
		}
		@table.Cell(table.CellProps{Class: "hide-m"}) {
			for _, usage := range page.Usages {
				if usage.ID == orEmpty(p.Recurrence.CategoryID) {
					@categoryName(usage.Name, usage.Color)
				}
			}
		}
		@table.Cell(table.CellProps{Class: "hide-m"}) {
			<form hx-post={ url } hx-target="#month" hx-swap="outerHTML" onclick="event.stopPropagation()" class="flex justify-end">
				<input type="hidden" name="month" value={ page.Month.Format(monthLayout) }/>
				<input type="hidden" name="category" value={ page.Filter.ID }/>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-busy": i18n.T(ctx, "form.confirming")}}) {
					<span>{ i18n.T(ctx, "month.confirm") }</span>
				}
			</form>
		}
		@table.Cell(table.CellProps{Class: utils.CN("text-right tabular-nums opacity-70", kindClass(p.Recurrence.Kind))}) {
			{ money(ctx, signed(p.Recurrence.Kind, p.Recurrence.Amount)) }
		}
	}
}

// occurrenceSheet is "confirmar ocorrência": the recurrence on a muted line over the transaction's fields filled from
// it, and "> confirmar".
templ occurrenceSheet(form occurrenceForm) {
	@sheet(sheetProps{
		Title:  i18n.T(ctx, "occurrence.title"),
		Action: "/recurrences/" + form.Recurrence.ID + "/occurrences/" + form.Date,
		Submit: i18n.T(ctx, "month.confirm"),
		Busy:   i18n.T(ctx, "form.confirming"),
		Error:  form.Errors["form"],
	}) {
		<p class="flex flex-wrap items-center gap-[1ch] text-xs text-muted-foreground">
			@description(form.Recurrence.Description)
			· { i18n.T(ctx, "recurrences.every_month", ruleDay(form.Recurrence.Rule)) }
			for _, category := range form.Categories {
				if category.ID == orEmpty(form.Recurrence.CategoryID) {
					· @categoryName(category.Name, category.Color)
				}
			}
		</p>
		@kindChoice(form.Kind, form.Errors["kind"])
		@amountField(form.Amount, i18n.T(ctx, "occurrence.hint"), form.Errors["amount"])
		@formField("description", i18n.T(ctx, "field.description"), form.Errors["description"]) {
			@input.Input(input.Props{ID: "description", Name: "description", Value: form.Description})
		}
		<div class="grid grid-cols-2 gap-[2ch]">
			@dateField("occurred_at", i18n.T(ctx, "field.date"), form.OccurredAt, form.Errors["occurred_at"])
			@formField("category_id", i18n.T(ctx, "field.category"), form.Errors["category_id"]) {
				@nativeselect.NativeSelect(nativeselect.Props{ID: "category_id", Name: "category_id", Class: "w-full", Attributes: ariaInvalid(form.Errors["category_id"])}) {
					@nativeselect.Option(nativeselect.OptionProps{Value: "", Selected: form.CategoryID == ""}) {
						{ i18n.T(ctx, "field.no_category") }
					}
					for _, category := range form.Categories {
						@nativeselect.Option(nativeselect.OptionProps{Value: category.ID, Selected: category.ID == form.CategoryID}) {
							{ category.Name }
						}
					}
				}
			}
		</div>
	}
}
