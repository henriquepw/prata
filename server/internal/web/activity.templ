package web

import (
	"context"
	"time"

	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/store"
)

// activityPhrase is what an op did, such as `transação "Uber" criada`, without the quoted label when it has none.
func activityPhrase(ctx context.Context, a store.Activity) string {
	phrase := i18n.T(ctx, "activity.entity."+a.Entity)
	if a.Label != "" {
		phrase += ` "` + a.Label + `"`
	}

	return phrase + " " + i18n.T(ctx, "activity.kind."+string(a.Kind))
}

// activityLog is the "Log de atividade" panel: one line per op, newest first, with the time in loc, and the
// prompt pinned to the bottom.
templ activityLog(activity []store.Activity, loc *time.Location) {
	@panel(i18n.T(ctx, "activity.title"), "log-panel", nil) {
		<ol class="log">
			for _, a := range activity {
				<li><span class="text-muted-foreground">{ "> [" + formatDate(a.CreatedAt, loc, "15:04") + "]" }</span> { a.Device } · { activityPhrase(ctx, a) }</li>
			}
			if len(activity) == 0 {
				<li class="text-muted-foreground"><span aria-hidden="true">{ `¯\_(ツ)_/¯` }</span> { i18n.T(ctx, "activity.empty") }</li>
			}
			<li class="log-prompt" aria-hidden="true"><span class="text-muted-foreground">{ ">" }</span> <span class="cursor">▋</span></li>
		</ol>
	}
}
