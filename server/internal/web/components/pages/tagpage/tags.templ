package tagpage

import (
	"github.com/henriquepw/prata/server/internal/l10n"
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/ui/empty"
	"github.com/henriquepw/prata/server/internal/web/components/ui/formfield"
	"github.com/henriquepw/prata/server/internal/web/components/ui/panel"
	"github.com/henriquepw/prata/server/internal/web/components/ui/sheet"
	"github.com/henriquepw/prata/server/internal/web/components/ui/table"
	"github.com/henriquepw/prata/server/internal/web/components/view/entry"
	"github.com/henriquepw/prata/server/internal/web/components/view/layout"
	"github.com/henriquepw/prata/server/internal/web/prefs"
	"github.com/henriquepw/prata/server/internal/web/components/ui/style"
)

// tagForm is the tag sheet: what the user typed, dates as YYYY-MM-DD, and an error message per field name,
// "form" holding a rejected commit.
type tagForm struct {
	ID      string
	Name    string
	StartAt string
	EndAt   string
	Errors  map[string]string
}

templ tagsPage(s layout.Props, tags []store.Tag) {
	{{ loc := s.Now.Location() }}
	@layout.Layout(s) {
		@panel.Panel(l10n.T(ctx, "nav.tags"), "", sheet.NewAction("/tags/new")) {
			if len(tags) == 0 {
				@empty.Empty(l10n.T(ctx, "tags.empty"))
			} else {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head(table.HeadProps{Class: "w-full"}) {
								{ l10n.T(ctx, "field.name") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ l10n.T(ctx, "tags.period") }
							}
						}
					}
					@table.Body() {
						for _, tag := range tags {
							@table.Row(sheet.Row("/tags/"+tag.ID, tag.ID == s.Flash)) {
								@table.Cell() {
									{ "#" + tag.Name }
								}
								@table.Cell(table.CellProps{Class: "text-right tabular-nums text-muted-foreground"}) {
									if tag.EndAt == nil {
										{ l10n.T(ctx, "tags.since", prefs.FormatDate(tag.StartAt, loc, prefs.DateLayout(ctx))) }
									} else {
										{ l10n.T(ctx, "tags.between", prefs.FormatDate(tag.StartAt, loc, prefs.DateLayout(ctx)), prefs.FormatDate(*tag.EndAt, loc, prefs.DateLayout(ctx))) }
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

templ tagSheet(form tagForm) {
	@sheet.Form(sheet.Props{
		Title:     l10n.T(ctx, style.IfElse(form.ID == "", "tags.new", "tags.edit")),
		Action:    style.IfElse(form.ID == "", "/tags", "/tags/"+form.ID),
		DeleteURL: style.IfElse(form.ID == "", "", "/tags/"+form.ID),
		Confirm:   l10n.T(ctx, "tags.confirm_delete"),
		Error:     form.Errors["form"],
	}) {
		@entry.NameField(form.Name, form.Errors["name"])
		<div class="grid grid-cols-2 gap-4">
			@formfield.Date("start_at", l10n.T(ctx, "field.start"), form.StartAt, form.Errors["start_at"])
			@entry.EndField(form.EndAt, form.Errors["end_at"])
		</div>
	}
}
