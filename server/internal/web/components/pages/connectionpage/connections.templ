package connectionpage

import (
	"time"

	"github.com/henriquepw/prata/server/internal/l10n"
	"github.com/henriquepw/prata/server/pkg/pluggy"
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/ui/badge"
	"github.com/henriquepw/prata/server/internal/web/components/ui/button"
	"github.com/henriquepw/prata/server/internal/web/components/ui/confirm"
	"github.com/henriquepw/prata/server/internal/web/components/ui/empty"
	"github.com/henriquepw/prata/server/internal/web/components/ui/formfield"
	"github.com/henriquepw/prata/server/internal/web/components/ui/input"
	"github.com/henriquepw/prata/server/internal/web/components/ui/panel"
	"github.com/henriquepw/prata/server/internal/web/components/ui/style"
	"github.com/henriquepw/prata/server/internal/web/components/ui/table"
	"github.com/henriquepw/prata/server/internal/web/components/view/layout"
	"github.com/henriquepw/prata/server/internal/web/prefs"
)

// connectionsPage is the Connections screen: the form that registers an Item over the list of Connections.
templ connectionsPage(s layout.Props, view connectionsView) {
	@layout.Layout(s) {
		<div class="flex flex-col gap-5">
			@connectionFormPanel(view)
			@connectionsPanel(view, s.Now.Location())
		</div>
	}
}

// connectionFormPanel registers a Connection by the Item id, onto a BRL account; without Pluggy credentials it sends
// the user to Settings. A response, a 422 included, swaps the screen's main.
templ connectionFormPanel(view connectionsView) {
	@panel.Panel(l10n.T(ctx, "connections.add"), "", nil) {
		if !view.HasCredentials {
			<p class="text-muted-foreground">
				{ l10n.T(ctx, "connections.no_credentials") }
				<button type="button" class={ style.TextAction } hx-get="/settings" hx-target="#sheet">{ "[" + l10n.T(ctx, "nav.settings") + "]" }</button>
			</p>
		} else {
			<form hx-post="/connections" hx-target="main" hx-select="main" hx-swap="outerHTML" hx-disable="find [type=submit]" class="flex flex-wrap items-end gap-4 justify-end">
				@formfield.Hint("item_id", l10n.T(ctx, "connections.item_id"), l10n.T(ctx, "connections.item_id_hint"), view.Errors["item_id"]) {
					@input.Input(input.Props{ID: "item_id", Name: "item_id", Value: view.ItemID, Required: true, Attributes: formfield.AriaInvalid(view.Errors["item_id"], templ.Attributes{"autocomplete": "off", "spellcheck": "false"})})
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"data-busy": l10n.T(ctx, "connections.adding")}}) {
					<span>&gt; { l10n.T(ctx, "connections.add_submit") }</span>
				}
			</form>
		}
	}
}

// fetchAction is the "fetch now" button of the panel head, shown once there is a Connection to fetch. A failure,
// answered with the page, swaps the screen's main.
templ fetchAction(show bool) {
	if show {
		<form hx-post="/connections/fetch" hx-target="main" hx-select="main" hx-swap="outerHTML" hx-disable="find button">
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Attributes: templ.Attributes{"data-busy": l10n.T(ctx, "connections.fetching")}}) {
				<span>{ l10n.T(ctx, "connections.fetch") }</span>
			}
		</form>
	}
}

// connectionState is the state chip of a Connection: reconnect when its Item asks the user to, else Pluggy's status.
templ connectionState(c store.Connection) {
	if pluggy.NeedsReconnect(c.Status, c.ExecutionStatus) {
		@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
			{ "[" + l10n.T(ctx, "connections.reconnect") + "]" }
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
			{ "[" + l10n.T(ctx, "connections.status."+c.Status) + "]" }
		}
	}
}

// connectionsPanel lists the Connections, each with its state and its remove button, under the error of the last
// "fetch now".
templ connectionsPanel(view connectionsView, loc *time.Location) {
	@panel.Panel(l10n.T(ctx, "nav.connections"), "", fetchAction(len(view.Connections) > 0)) {
		if view.FetchError != "" {
			<p role="alert" class="text-destructive">! { view.FetchError }</p>
		}
		if len(view.Connections) == 0 {
			@empty.Empty(l10n.T(ctx, "connections.empty"))
		} else {
			@table.Table() {
				@table.Header() {
					@table.Row() {
						@table.Head(table.HeadProps{Class: "w-full"}) {
							{ l10n.T(ctx, "connections.institution") }
						}
						@table.Head(table.HeadProps{Class: "@max-2xl/console:hidden"}) {
							{ l10n.T(ctx, "movements.account") }
						}
						@table.Head() {
							{ l10n.T(ctx, "connections.last_update") }
						}
						@table.Head() {
							{ l10n.T(ctx, "connections.state") }
						}
						@table.Head()
					}
				}
				@table.Body() {
					for _, c := range view.Connections {
						@table.Row() {
							@table.Cell(table.CellProps{Class: "whitespace-normal"}) {
								{ c.Institution }
							}
							@table.Cell(table.CellProps{Class: "@max-2xl/console:hidden text-muted-foreground"}) {
								{ c.AccountName }
							}
							@table.Cell(table.CellProps{Class: "tabular-nums text-muted-foreground"}) {
								{ prefs.LocalTime(ctx, c.LastUpdatedAt.String, loc) }
							}
							@table.Cell() {
								@connectionState(c)
							}
							@table.Cell(table.CellProps{Class: "text-right", Attributes: templ.Attributes{"data-confirm": true}}) {
								@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantDestructive, Size: button.SizeSm, Attributes: templ.Attributes{"onclick": templ.JSUnsafeFuncCall(confirm.Toggle), "data-focus": true}}) {
									{ l10n.T(ctx, "connections.remove") }
								}
								@confirm.Inline(l10n.T(ctx, "connections.confirm_remove", c.Institution), l10n.T(ctx, "connections.remove_yes"), templ.Attributes{"hx-delete": "/connections/" + c.ID.String()})
							}
						}
					}
				}
			}
		}
	}
}
