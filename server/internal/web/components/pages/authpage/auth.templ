package authpage

import (
	"strings"

	"github.com/henriquepw/prata/server/internal/l10n"
	"github.com/henriquepw/prata/server/internal/web/components/ui/button"
	"github.com/henriquepw/prata/server/internal/web/components/ui/empty"
	"github.com/henriquepw/prata/server/internal/web/components/ui/field"
	"github.com/henriquepw/prata/server/internal/web/components/ui/formfield"
	"github.com/henriquepw/prata/server/internal/web/components/ui/input"
	"github.com/henriquepw/prata/server/internal/web/components/ui/panel"
	"github.com/henriquepw/prata/server/internal/web/components/view/entrance"
	"github.com/henriquepw/prata/server/internal/web/components/view/layout"
	"github.com/henriquepw/prata/server/internal/web/components/view/settingform"
)

// Form is the login or signup form with what the user typed and the errors to show: one per field
// and Error for the whole form, such as a closed signup.
type Form struct {
	Email         string
	EmailError    string
	PasswordError string
	Error         string
	CanSignUp     bool
	HasUsers      bool
	// Choices are the initial settings the signup carries in hidden fields, by field name.
	Choices map[string]string
}

// choiceNames are the fields of the initial settings, in the order the screen shows them.
var choiceNames = []string{"language", "date_format", "number_format", "currency"}

// figlet404 is 404 in the ANSI Shadow font.
const figlet404 = `██╗  ██╗ ██████╗ ██╗  ██╗
██║  ██║██╔═████╗██║  ██║
███████║██║██╔██║███████║
╚════██║████╔╝██║╚════██║
     ██║╚██████╔╝     ██║
     ╚═╝ ╚═════╝      ╚═╝`

templ LoginPage(form Form) {
	@authPage(l10n.T(ctx, "auth.sign_in"), "/login", form) {
		if form.CanSignUp {
			<p>
				{ l10n.T(ctx, "auth.no_account") } <a href="/signup" class="text-foreground underline underline-offset-4">{ l10n.T(ctx, "auth.sign_up") }</a>
			</p>
		}
	}
}

templ SignupPage(form Form) {
	@authPage(l10n.T(ctx, "auth.sign_up"), "/signup", form) {
		if form.HasUsers {
			<p>
				{ l10n.T(ctx, "auth.has_account") } <a href="/login" class="text-foreground underline underline-offset-4">{ l10n.T(ctx, "auth.sign_in") }</a>
			</p>
		}
	}
}

// SetupPage is the initial settings: the language, date format, number format and currency, asked before the
// signup and stored by it.
templ SetupPage(form settingform.Form) {
	@layout.Document(l10n.T(ctx, "setup.title")) {
		@entrancePanel(entrance.Figlet, "Prata", l10n.T(ctx, "setup.title"), "max-w-100") {
			<form method="post" action="/setup" class="flex flex-col gap-4">
				<p class="text-xs text-muted-foreground">{ l10n.T(ctx, "setup.note") }</p>
				@settingform.LanguageField(form)
				@settingform.DateFormatField(form)
				@settingform.NumberFormatField(form)
				@settingform.CurrencyField(form)
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					{ "> " + l10n.T(ctx, "setup.continue") }
				}
			</form>
		}
	}
}

// authPage is the entrance shared by login and signup: a form under the PRATA figlet.
templ authPage(title, action string, form Form) {
	@layout.Document(title) {
		@entrancePanel(entrance.Figlet, "Prata", title, "max-w-100") {
			<form method="post" action={ templ.SafeURL(action) } class="flex flex-col gap-4">
				for _, name := range choiceNames {
					if form.Choices[name] != "" {
						<input type="hidden" name={ name } value={ form.Choices[name] }/>
					}
				}
				@formfield.Field("email", l10n.T(ctx, "auth.email"), form.EmailError) {
					@input.Input(input.Props{ID: "email", Name: "email", Type: "email", Value: form.Email, Required: true, Attributes: formfield.AriaInvalid(form.EmailError, templ.Attributes{"autocomplete": "email"})})
				}
				@formfield.Field("password", l10n.T(ctx, "auth.password"), form.PasswordError) {
					@input.Input(input.Props{ID: "password", Name: "password", Type: "password", Required: true, Attributes: formfield.AriaInvalid(form.PasswordError)})
				}
				if form.Error != "" {
					@field.Error() {
						{ form.Error }
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					{ "> " + strings.ToLower(title) }
				}
			</form>
			<div class="mt-4 flex flex-col gap-2 text-xs text-muted-foreground">
				{ children... }
			</div>
		}
	}
}

// NotFoundPage is the entrance for a path with no route: a panel under the 404 figlet logging the missing path,
// with the way back home.
templ NotFoundPage(path string) {
	@layout.Document(l10n.T(ctx, "notfound.title")) {
		@entrancePanel(figlet404, "404", l10n.T(ctx, "notfound.title"), "max-w-100") {
			@empty.Empty(l10n.T(ctx, "notfound.text"), "mb-4 text-xs")
			@button.Button(button.Props{Href: "/"}) {
				{ "> " + l10n.T(ctx, "notfound.back") }
			}
		}
	}
}

// entrancePanel is the console entrance of the pages without a session: the entrance.Frame with a panel holding the title
// and the children.
templ entrancePanel(art, label, title, width string) {
	@entrance.Frame(art, label, width) {
		<section class={ panel.Box, "w-full bg-background" }>
			<header class={ panel.Head }>
				<h1 class={ panel.Title }>{ title }</h1>
			</header>
			{ children... }
		</section>
	}
}
