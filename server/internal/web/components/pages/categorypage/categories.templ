package categorypage

import (
	"strings"

	"github.com/henriquepw/prata/server/pkg/id"
	"github.com/henriquepw/prata/server/internal/l10n"
	"github.com/henriquepw/prata/server/internal/web/components/ui/choice"
	"github.com/henriquepw/prata/server/internal/web/components/ui/sheet"
	"github.com/henriquepw/prata/server/internal/web/components/view/budget"
	"github.com/henriquepw/prata/server/internal/web/components/view/category"
	"github.com/henriquepw/prata/server/internal/web/components/view/entry"
	"github.com/henriquepw/prata/server/internal/web/components/view/layout"
	"github.com/henriquepw/prata/server/internal/web/components/ui/style"
)

// categoryForm is the category sheet: what the user typed and an error message per field name,
// "form" holding a rejected commit.
type categoryForm struct {
	ID          id.ID
	Name        string
	Color       string
	IsDaily     bool
	IsDefault   bool
	MarkDefault bool
	Errors      map[string]string
}

// categoriesPage is the Categories screen, which is the division of the monthly income (budget.Screen).
templ categoriesPage(s layout.Props, form budget.Form) {
	@layout.Layout(s) {
		@budget.Screen(form, s.Flash)
	}
}

templ categorySheet(form categoryForm) {
	@sheet.Form(sheet.Props{
		Title:     l10n.T(ctx, style.IfElse(form.ID == "", "categories.new", "categories.edit")),
		Action:    style.IfElse(form.ID == "", "/categories", "/categories/"+form.ID.String()),
		DeleteURL: style.IfElse(form.ID == "" || form.IsDefault, "", "/categories/"+form.ID.String()),
		Confirm:   l10n.T(ctx, "categories.confirm_delete"),
		Error:     form.Errors["form"],
	}) {
		@entry.NameField(form.Name, form.Errors["name"])
		@choice.Field("color", l10n.T(ctx, "categories.color"), "", form.Errors["color"]) {
			for _, color := range category.Colors {
				@choice.Option("color", color.Value, color.Value == form.Color) {
					<span class={ color.Class } aria-hidden="true">■</span> { strings.ToLower(l10n.T(ctx, "color."+color.Value)) }
				}
			}
		}
		@choice.Field("is_daily", l10n.T(ctx, "categories.daily"), l10n.T(ctx, "categories.daily_help"), "") {
			@choice.Option("is_daily", "1", form.IsDaily) {
				{ l10n.T(ctx, "categories.yes") }
			}
			@choice.Option("is_daily", "0", !form.IsDaily) {
				{ l10n.T(ctx, "categories.no") }
			}
		}
		<fieldset class="contents" disabled?={ form.IsDefault }>
			@choice.Field("is_default", l10n.T(ctx, "categories.default"), l10n.T(ctx, "categories.default_help"), "") {
				@choice.Option("is_default", "1", form.IsDefault || form.MarkDefault) {
					{ l10n.T(ctx, "categories.yes") }
				}
				@choice.Option("is_default", "0", !form.IsDefault && !form.MarkDefault) {
					{ l10n.T(ctx, "categories.no") }
				}
			}
		</fieldset>
	}
}
