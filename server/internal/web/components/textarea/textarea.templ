package textarea

import (
	"github.com/henriquepw/prata/server/internal/web/utils"
	"strconv"
)

type Props struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Name        string
	Value       string
	Form        string
	Placeholder string
	Rows        int
	Disabled    bool
	ReadOnly    bool
}

templ Textarea(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	<textarea
		id={ p.ID }
		if _, hasSlot := p.Attributes["data-slot"]; !hasSlot {
			data-slot="textarea"
		}
		if p.Name != "" {
			name={ p.Name }
		}
		if p.Form != "" {
			form={ p.Form }
		}
		if p.Placeholder != "" {
			placeholder={ p.Placeholder }
		}
		if p.Rows > 0 {
			rows={ strconv.Itoa(p.Rows) }
		}
		disabled?={ p.Disabled }
		readonly?={ p.ReadOnly }
		class={
			utils.CN(
				// Structure from base/ui/textarea.tsx, look from the prata-web-ui skill.
				"border-line focus-visible:border-primary aria-invalid:border-destructive caret-primary [caret-shape:block] transition-colors duration-(--snap) ease-(--ease) disabled:bg-line-soft rounded-none border bg-transparent px-2.5 py-2 text-xs md:text-xs flex field-sizing-content min-h-16 w-full outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50",
				p.Class,
			),
		}
		{ p.Attributes... }
	>{ p.Value }</textarea>
}
