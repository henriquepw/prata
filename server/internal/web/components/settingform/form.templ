package settingform

import (
	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/console"
	"github.com/henriquepw/prata/server/internal/web/components/field"
	"github.com/henriquepw/prata/server/internal/web/components/nativeselect"
	"github.com/henriquepw/prata/server/internal/web/prefs"
)

// Form is the Configurações sheet: the Preferences and the account's Moeda shown or typed and an error message
// per field name. With OpenFinance on, it also has the Pluggy client id, never the secret, and whether credentials
// are saved.
type Form struct {
	store.Preferences
	Currency       string
	OpenFinance    bool
	PluggyClientID string
	HasPluggy      bool
	Errors         map[string]string
}

templ LanguageField(form Form) {
	@console.FormField("language", i18n.T(ctx, "settings.language"), form.Errors["language"]) {
		@nativeselect.NativeSelect(nativeselect.Props{ID: "language", Name: "language", Class: "w-full", Attributes: console.AriaInvalid(form.Errors["language"])}) {
			for _, l := range prefs.Languages {
				@nativeselect.Option(nativeselect.OptionProps{Value: l.Value, Selected: l.Value == form.Language}) {
					{ l.Label }
				}
			}
		}
	}
}

templ DateFormatField(form Form) {
	@console.FormField("date_format", i18n.T(ctx, "settings.date_format"), form.Errors["date_format"]) {
		@nativeselect.NativeSelect(nativeselect.Props{ID: "date_format", Name: "date_format", Class: "w-full", Attributes: console.AriaInvalid(form.Errors["date_format"])}) {
			for _, f := range prefs.DateFormats {
				@nativeselect.Option(nativeselect.OptionProps{Value: f.Value, Selected: f.Value == form.DateFormat}) {
					{ i18n.T(ctx, "date_format."+f.Value) }
				}
			}
		}
	}
}

templ NumberFormatField(form Form) {
	@console.FormField("number_format", i18n.T(ctx, "settings.number_format"), form.Errors["number_format"]) {
		@nativeselect.NativeSelect(nativeselect.Props{ID: "number_format", Name: "number_format", Class: "w-full", Attributes: console.AriaInvalid(form.Errors["number_format"])}) {
			for _, f := range prefs.NumberFormats {
				@nativeselect.Option(nativeselect.OptionProps{Value: f.Value, Selected: f.Value == form.NumberFormat}) {
					{ f.Value }
				}
			}
		}
	}
}

templ CurrencyField(form Form) {
	@console.FormField("currency", i18n.T(ctx, "settings.currency"), form.Errors["currency"]) {
		@nativeselect.NativeSelect(nativeselect.Props{ID: "currency", Name: "currency", Class: "w-full", Attributes: console.AriaInvalid(form.Errors["currency"])}) {
			for _, c := range prefs.Currencies {
				@nativeselect.Option(nativeselect.OptionProps{Value: c.Value, Selected: c.Value == form.Currency}) {
					{ c.Value + " (" + c.Symbol + ")" }
				}
			}
		}
		@field.Description() {
			{ i18n.T(ctx, "settings.currency_note") }
		}
	}
}
