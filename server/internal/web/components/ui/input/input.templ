package input

import "github.com/henriquepw/prata/server/internal/web/components/ui/style"

// Mask is how an Input reshapes what is typed; the zero value leaves it as typed.
type Mask string

const (
	// MaskMoney fills the digits typed as an amount from the cents, through MoneyScript.
	MaskMoney Mask = "money"
)

var moneyOnce = templ.NewOnceHandle()

// MoneyScript masks every [data-mask=money] input as the digits are typed, filling from the cents: 1, 12 and 123 become
// 0,01, 0,12 and 1,23, in the number format of <html data-decimal data-thousands>. It renders once per page, and
// listens in the capture phase so other input listeners already read the masked value. Input renders it with MaskMoney.
templ MoneyScript() {
	@moneyOnce.Once() {
		<script>
			if (!window.moneyMask) {
				window.moneyMask = true
				addEventListener('input', e => {
					if (!e.target.matches('[data-mask=money]')) return
					const d = document.documentElement.dataset, raw = e.target.value.replace(/\D/g, ''), n = raw.replace(/^0+/, '').padStart(3, '0')
					e.target.value = !raw || (raw.match(/^0*$/) && e.inputType?.startsWith('delete')) ? '' : n.slice(0, -2).replace(/\B(?=(\d{3})+$)/g, d.thousands) + d.decimal + n.slice(-2)
				}, true)
			}
		</script>
	}
}

type Props struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Name        string
	Type        string
	Form        string
	Placeholder string
	Value       string
	Disabled    bool
	ReadOnly    bool
	Required    bool
	Accept      string
	Mask        Mask
}

templ Input(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Mask == MaskMoney {
		@MoneyScript()
	}
	if p.ID == "" {
		{{ p.ID = style.RandomID() }}
	}
	<input
		id={ p.ID }
		if _, hasSlot := p.Attributes["data-slot"]; !hasSlot {
			data-slot="input"
		}
		if p.Type != "" {
			type={ p.Type }
		}
		if p.Name != "" {
			name={ p.Name }
		}
		if p.Placeholder != "" {
			placeholder={ p.Placeholder }
		}
		if p.Value != "" {
			value={ p.Value }
		}
		if p.Type == "file" && p.Accept != "" {
			accept={ p.Accept }
		}
		if p.Form != "" {
			form={ p.Form }
		}
		disabled?={ p.Disabled }
		data-disabled?={ p.Disabled }
		readonly?={ p.ReadOnly }
		required?={ p.Required }
		if p.Mask != "" {
			data-mask={ string(p.Mask) }
		}
		class={
			style.CN(
				// Structure from base/ui/input.tsx, look from the prata-web-ui skill.
				"border-line focus-visible:border-primary aria-invalid:border-destructive caret-primary [caret-shape:block] transition-colors disabled:bg-line-soft h-8 rounded-none border bg-transparent px-2.5 py-1 text-xs file:h-6 file:text-xs file:font-medium md:text-xs w-full min-w-0 outline-none file:inline-flex file:border-0 file:bg-transparent file:text-foreground placeholder:text-muted-foreground disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50",
				p.Class,
			),
		}
		{ p.Attributes... }
	/>
}
