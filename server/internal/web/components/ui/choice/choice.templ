package choice

import (
	"github.com/henriquepw/prata/server/internal/web/components/ui/field"
	"github.com/henriquepw/prata/server/internal/web/components/ui/formfield"
	"github.com/henriquepw/prata/server/internal/web/components/ui/style"
)

// Field is a short choice, as in [despesa] [receita]: the Option radios as children, drawn as buttons with the
// checked one inverted.
templ Field(name, label, help, message string) {
	@field.Field() {
		<span id={ name + "-label" } class="text-2xs tracking-widest text-muted-foreground uppercase">
			{ label }
			if help != "" {
				@HelpMark(help)
			}
		</span>
		<div role="radiogroup" aria-labelledby={ name + "-label" } class={ Group } { formfield.AriaInvalid(message)... }>
			{ children... }
		</div>
		@formfield.Note("", message)
	}
}

// HelpMark is the primary "?" after a field label: help, which it reads as, shows inverted under it on hover or focus.
templ HelpMark(help string) {
	<span class="relative ml-1 cursor-help text-primary after:pointer-events-none after:absolute after:top-full after:left-0 after:z-10 after:mt-1 after:w-72 after:bg-foreground after:px-2 after:py-2.5 after:text-2xs after:tracking-normal after:text-background after:normal-case after:opacity-0 after:transition-opacity after:content-[attr(data-tip)] hover:after:opacity-100 focus-visible:after:opacity-100" tabindex="0" role="img" aria-label={ help } data-tip={ help }>?</span>
}

// Group lays out the Option buttons of a short choice, wrapping; aria-invalid turns their borders red.
const Group = "group/choice flex flex-wrap gap-2"

// Option is one radio of a Field, with its label as children: a button whose checked state is inverted.
templ Option(name, value string, checked bool) {
	<label>
		<input type="radio" name={ name } value={ value } checked?={ checked } class="peer absolute opacity-0"/>
		<span class={ "flex cursor-pointer items-center gap-2 border border-line px-3 py-1 text-xs tracking-wider uppercase group-aria-invalid/choice:border-destructive peer-checked:border-foreground peer-checked:bg-foreground peer-checked:text-background peer-focus-visible:outline-1 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary hover:border-foreground", style.Inverted }>
			{ children... }
		</span>
	</label>
}
