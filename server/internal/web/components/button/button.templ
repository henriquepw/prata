package button

import "github.com/henriquepw/prata/server/internal/web/utils"

type Variant string
type Size string
type Type string

const (
	VariantDefault     Variant = "default"
	VariantDestructive Variant = "destructive"
	VariantOutline     Variant = "outline"
	VariantSecondary   Variant = "secondary"
	VariantGhost       Variant = "ghost"
	VariantLink        Variant = "link"
)

const (
	TypeButton Type = "button"
	TypeReset  Type = "reset"
	TypeSubmit Type = "submit"
)

const (
	SizeDefault Size = "default"
	SizeXs      Size = "xs"
	SizeSm      Size = "sm"
	SizeLg      Size = "lg"
	SizeIcon    Size = "icon"
	SizeIconXs  Size = "icon-xs"
	SizeIconSm  Size = "icon-sm"
	SizeIconLg  Size = "icon-lg"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    Variant
	Size       Size
	Href       string
	Target     string
	Disabled   bool
	Type       Type
	Form       string
}

// Structure from base/ui/button.tsx, look from the prata-web-ui skill: caps with tracking, --line-strong
// border and a hover that inverts in --snap.
const baseClasses = "aria-invalid:border-destructive rounded-none border border-line-strong bg-clip-padding text-xs font-medium uppercase tracking-wider hover:border-foreground hover:bg-foreground hover:text-background active:not-aria-[haspopup]:translate-y-px [&_svg:not([class*='size-'])]:size-4 group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-colors duration-(--snap) ease-(--ease) select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"

templ Button(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Type == "" {
		{{ p.Type = TypeButton }}
	}
	if p.Variant == "" {
		{{ p.Variant = VariantDefault }}
	}
	if p.Size == "" {
		{{ p.Size = SizeDefault }}
	}
	if p.Href != "" && !p.Disabled {
		// Base UI's Button with nativeButton false (shadcn renders the link
		// through it): useButton makes the element a button.
		<a
			if _, ok := p.Attributes["id"]; !ok && p.ID != "" {
				id={ p.ID }
			}
			href={ templ.SafeURL(p.Href) }
			if p.Target != "" {
				target={ p.Target }
			}
			if _, ok := p.Attributes["data-slot"]; !ok {
				data-slot="button"
			}
			if _, ok := p.Attributes["role"]; !ok {
				role="button"
			}
			if _, ok := p.Attributes["tabindex"]; !ok {
				tabindex="0"
			}
			class={ utils.CN(baseClasses, p.variantClasses(), p.sizeClasses(), p.Class) }
			{ p.Attributes... }
		>
			{ children... }
		</a>
	} else {
		<button
			if _, ok := p.Attributes["id"]; !ok && p.ID != "" {
				id={ p.ID }
			}
			if _, ok := p.Attributes["data-slot"]; !ok {
				data-slot="button"
			}
			if _, ok := p.Attributes["tabindex"]; !ok {
				tabindex="0"
			}
			class={ utils.CN(baseClasses, p.variantClasses(), p.sizeClasses(), p.Class) }
			if _, ok := p.Attributes["type"]; !ok && p.Type != "" {
				type={ string(p.Type) }
			}
			if p.Form != "" {
				form={ p.Form }
			}
			disabled?={ p.Disabled }
			data-disabled?={ p.Disabled }
			{ p.Attributes... }
		>
			{ children... }
		</button>
	}
}

// Variants is shadcn's buttonVariants: the classes of a button with these
// props, for an element that is no Button.
func Variants(p Props) string {
	return utils.CN(baseClasses, p.variantClasses(), p.sizeClasses(), p.Class)
}

func (b Props) variantClasses() string {
	switch b.Variant {
	case VariantDestructive:
		return "border-destructive text-destructive hover:border-destructive hover:bg-destructive"
	case VariantSecondary:
		return "bg-line-soft"
	case VariantGhost:
		return "border-transparent text-muted-foreground"
	case VariantLink:
		return "border-transparent text-primary normal-case tracking-normal underline-offset-4 hover:border-transparent hover:bg-transparent hover:text-primary hover:underline"
	case VariantOutline:
		return ""
	default:
		return "border-primary bg-primary text-primary-foreground"
	}
}

func (b Props) sizeClasses() string {
	switch b.Size {
	case SizeXs:
		return "h-6 gap-1 rounded-none px-2 text-xs has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 [&_svg:not([class*='size-'])]:size-3"
	case SizeSm:
		return "h-7 gap-1 rounded-none px-2.5 text-2xs has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 [&_svg:not([class*='size-'])]:size-3.5"
	case SizeLg:
		return "h-9 gap-1.5 px-2.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2"
	case SizeIcon:
		return "size-8"
	case SizeIconXs:
		return "size-6 rounded-none [&_svg:not([class*='size-'])]:size-3"
	case SizeIconSm:
		return "size-7 rounded-none"
	case SizeIconLg:
		return "size-9"
	default:
		return "h-8 gap-1.5 px-2.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2"
	}
}
