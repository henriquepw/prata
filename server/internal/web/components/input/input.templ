package input

import "github.com/henriquepw/prata/server/internal/web/utils"

type Props struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Name        string
	Type        string
	Form        string
	Placeholder string
	Value       string
	Disabled    bool
	ReadOnly    bool
	Required    bool
	Accept  string
}

templ Input(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	<input
		id={ p.ID }
		if _, hasSlot := p.Attributes["data-slot"]; !hasSlot {
			data-slot="input"
		}
		if p.Type != "" {
			type={ p.Type }
		}
		if p.Name != "" {
			name={ p.Name }
		}
		if p.Placeholder != "" {
			placeholder={ p.Placeholder }
		}
		if p.Value != "" {
			value={ p.Value }
		}
		if p.Type == "file" && p.Accept != "" {
			accept={ p.Accept }
		}
		if p.Form != "" {
			form={ p.Form }
		}
		disabled?={ p.Disabled }
		data-disabled?={ p.Disabled }
		readonly?={ p.ReadOnly }
		required?={ p.Required }
		class={
			utils.CN(
				// Structure from base/ui/input.tsx, look from the prata-web-ui skill.
				"border-line focus-visible:border-primary aria-invalid:border-destructive caret-primary [caret-shape:block] transition-colors duration-(--snap) ease-(--ease) disabled:bg-line-soft h-8 rounded-none border bg-transparent px-2.5 py-1 text-xs file:h-6 file:text-xs file:font-medium md:text-xs w-full min-w-0 outline-none file:inline-flex file:border-0 file:bg-transparent file:text-foreground placeholder:text-muted-foreground disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50",
				p.Class,
			),
		}
		{ p.Attributes... }
	/>
}
