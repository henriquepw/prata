package web

import (
	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/web/components/console"
	"github.com/henriquepw/prata/server/internal/web/components/shell"

	"github.com/henriquepw/prata/server/internal/web/shared"
)

// welcomePage is the tela inicial after a signup, without the app navigation: a panel explaining the Receita mensal,
// the division and the limite diário, then the division form filled with the Divisão sugerida and the Modo do limite
// diário with mode checked, as sibling panels, and "configurar depois" going home.
templ welcomePage(form budgetForm, mode string) {
	@shell.Document(i18n.T(ctx, "welcome.title")) {
		@entranceShell(figlet, "Prata", "max-w-2xl") {
			<div class="flex w-full flex-col gap-5 [&_.panel]:bg-background">
				<section class={ console.PanelBox }>
					<header class={ console.PanelHead }>
						<h1 class={ console.PanelTitle }>{ i18n.T(ctx, "welcome.title") }</h1>
					</header>
					<div class="flex flex-col gap-2 text-xs text-muted-foreground">
						<p>{ i18n.T(ctx, "welcome.income") }</p>
						<p>{ i18n.T(ctx, "welcome.division") }</p>
						<p>{ i18n.T(ctx, "welcome.daily_limit") }</p>
					</div>
				</section>
				@budgetScreen(form, "") {
					@console.Panel(i18n.T(ctx, "settings.daily_limit_mode"), "", nil) {
						@console.ChoiceField("daily_limit_mode", i18n.T(ctx, "settings.daily_limit_mode"), i18n.T(ctx, "welcome.modes"), form.Errors["daily_limit_mode"]) {
							for _, m := range shared.DailyLimitModes {
								@console.ChoiceOption("daily_limit_mode", m.Value, m.Value == mode) {
									{ i18n.T(ctx, "daily_limit_mode."+m.Value) }
								}
							}
						}
					}
				}
				<p class="self-start bg-background px-2 py-1 text-xs text-muted-foreground">
					<a href="/" class="text-foreground underline underline-offset-4">{ i18n.T(ctx, "welcome.later") }</a>
				</p>
			</div>
		}
	}
}
