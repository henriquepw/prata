package web

import (
	"strings"

	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/web/shared"
	"github.com/henriquepw/prata/server/internal/web/utils"
)

// launchPanel is the Mês prompt: "> " and a line that previews, as typed, the transaction enter creates in the month
// on screen, which the answer morphs, so only what changed moves and the new row flashes, then clears the line; a 422
// swaps only the preview. headScript focuses it on "/", completes "@" and "#" on tab and blurs it on esc.
templ launchPanel(page month) {
	@panel(i18n.T(ctx, "launch.title"), "", launchKeys()) {
		<form
			hx-post="/launch"
			hx-target="#month"
			hx-swap="outerMorph"
			hx-status:422="target:#launch-preview swap:innerHTML"
			hx-on:htmx:after:request="event.target === this && event.detail.ctx.response.status === 200 && this.reset()"
		>
			<input type="hidden" name="month" value={ page.yearMonth() }/>
			<input type="hidden" name="category" value={ page.Filter.ID }/>
			<label class={ utils.CN(prompt, "mb-0 text-base") }>
				<span class="text-primary" aria-hidden="true">&gt;</span>
				<input
					class={ promptInput }
					id="launch"
					name="line"
					autofocus?={ page.Focus }
					type="text"
					autocomplete="off"
					spellcheck="false"
					placeholder={ i18n.T(ctx, "launch.placeholder") }
					aria-label={ i18n.T(ctx, "launch.input") }
					aria-describedby="launch-preview"
					hx-get="/launch"
					hx-trigger="input changed delay:150ms"
					hx-include="closest form"
					hx-target="#launch-preview"
					hx-swap="innerHTML"
				/>
			</label>
			<div id="launch-preview" class="mt-3 min-h-5 text-xs" aria-live="polite">
				@launchPreview("", launchLine{})
			</div>
		</form>
	}
}

// launchKeys is the prompt panel's "/ focar · enter lançar".
templ launchKeys() {
	<span class={ monthKeys }><kbd>/</kbd> { i18n.T(ctx, "launch.focus") } · <kbd>enter</kbd> { i18n.T(ctx, "launch.submit") }</span>
}

// launchPreview is what line saves, as "[despesa] −R$ 45,90 "padaria" ■ Mercado #casa 19/11/2026", with each problem
// as "! falta o valor" or "! @x não existe", over the "tab" completions; the syntax while line is empty.
templ launchPreview(line string, l launchLine) {
	if strings.TrimSpace(line) == "" {
		<p class="text-muted-foreground">{ i18n.T(ctx, "launch.hint") }</p>
	} else {
		<p class="flex flex-wrap items-center gap-x-3 gap-y-1">
			<span class="bg-foreground px-1 text-2xs tracking-wider text-background uppercase">[{ strings.ToLower(i18n.T(ctx, "kind."+l.Kind)) }]</span>
			if l.Amount == 0 {
				<span class="text-destructive">! { i18n.T(ctx, "launch.no_amount") }</span>
			} else {
				<span class={ utils.CN("tabular-nums", kindClass(l.Kind)) }>{ shared.Money(ctx, signed(l.Kind, l.Amount)) }</span>
			}
			if l.Description == "" {
				@description(nil)
			} else {
				<span>"{ l.Description }"</span>
			}
			if l.Category.ID != "" {
				@categoryName(l.Category.Name, l.Category.Color)
			}
			if l.Tag.ID != "" {
				<span class="text-muted-foreground">#{ l.Tag.Name }</span>
			}
			<span class="tabular-nums text-muted-foreground">{ dayOf(l.Date).Format(shared.DateLayout(ctx)) }</span>
			for _, word := range l.Unknown {
				<span class="text-destructive">! { i18n.T(ctx, "launch.unknown", word) }</span>
			}
		</p>
	}
	if len(l.Suggestions) > 0 {
		<p class="launch-suggestions mt-2 flex flex-wrap gap-2 text-muted-foreground [&_kbd]:text-primary">
			<kbd>tab</kbd>
			for _, suggestion := range l.Suggestions {
				<b class="bg-line-soft px-1 font-normal text-foreground">{ suggestion }</b>
			}
		</p>
	}
}
