package web

import (
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/input"
	"github.com/henriquepw/prata/server/internal/web/components/nativeselect"
	"github.com/henriquepw/prata/server/internal/web/components/table"
	"github.com/henriquepw/prata/server/internal/web/utils"
)

// recurrenceForm is the recurrence sheet: what the user typed, the categories to pick from and an error
// message per field name, "form" holding a rejected commit.
type recurrenceForm struct {
	ID          string
	Description string
	Kind        string
	Amount      string
	CategoryID  string
	Day         string
	StartAt     string
	EndAt       string
	Categories  []store.Category
	Errors      map[string]string
}

templ recurrencesPage(s shell, recurrences []store.Recurrence) {
	@layout(s) {
		@panel("Recorrências", "", newAction("/recurrences/new")) {
			if len(recurrences) == 0 {
				@empty("nenhuma recorrência ainda")
			} else {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head(table.HeadProps{Class: "w-full"}) {
								Descrição
							}
							@table.Head() {
								Dia
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								Valor
							}
						}
					}
					@table.Body() {
						for _, recurrence := range recurrences {
							@table.Row(sheetRow("/recurrences/"+recurrence.ID, recurrence.ID == s.Flash)) {
								@table.Cell(table.CellProps{Class: "whitespace-normal"}) {
									{ utils.IfElse(recurrence.Description == nil, "Sem descrição", orEmpty(recurrence.Description)) }
								}
								@table.Cell(table.CellProps{Class: "tabular-nums text-muted-foreground"}) {
									todo dia { ruleDay(recurrence.Rule) }
								}
								@table.Cell(table.CellProps{Class: utils.CN("text-right tabular-nums", kindClass(recurrence.Kind))}) {
									{ money(ctx, signed(recurrence.Kind, recurrence.Amount)) }
								}
							}
						}
					}
				}
			}
		}
	}
}

templ recurrenceSheet(form recurrenceForm) {
	@sheet(sheetProps{
		Title:     utils.IfElse(form.ID == "", "Nova recorrência", "Editar recorrência"),
		Action:    utils.IfElse(form.ID == "", "/recurrences", "/recurrences/"+form.ID),
		DeleteURL: utils.IfElse(form.ID == "", "", "/recurrences/"+form.ID),
		Confirm:   "Excluir esta recorrência? Ela para de gerar pendentes; as transações já confirmadas continuam.",
		Error:     form.Errors["form"],
	}) {
		@formField("description", "Descrição", form.Errors["description"]) {
			@input.Input(input.Props{ID: "description", Name: "description", Value: form.Description})
		}
		@kindChoice(form.Kind, form.Errors["kind"])
		@formField("amount", "Valor", form.Errors["amount"]) {
			@input.Input(input.Props{ID: "amount", Name: "amount", Value: form.Amount, Placeholder: amount(ctx, 0), Required: true, Attributes: ariaInvalid(form.Errors["amount"])})
		}
		@formField("category_id", "Categoria", form.Errors["category_id"]) {
			@nativeselect.NativeSelect(nativeselect.Props{ID: "category_id", Name: "category_id", Class: "w-full", Attributes: ariaInvalid(form.Errors["category_id"])}) {
				@nativeselect.Option(nativeselect.OptionProps{Value: "", Selected: form.CategoryID == ""}) {
					Sem categoria
				}
				for _, category := range form.Categories {
					@nativeselect.Option(nativeselect.OptionProps{Value: category.ID, Selected: category.ID == form.CategoryID}) {
						{ category.Name }
					}
				}
			}
		}
		@formField("day", "Dia do mês (1 a 31)", form.Errors["day"]) {
			@input.Input(input.Props{ID: "day", Name: "day", Type: "number", Value: form.Day, Required: true, Attributes: ariaInvalid(form.Errors["day"])})
		}
		@formField("start_at", "Início", form.Errors["start_at"]) {
			@input.Input(input.Props{ID: "start_at", Name: "start_at", Type: "date", Value: form.StartAt, Required: true, Attributes: ariaInvalid(form.Errors["start_at"])})
		}
		@formField("end_at", "Fim (opcional)", form.Errors["end_at"]) {
			@input.Input(input.Props{ID: "end_at", Name: "end_at", Type: "date", Value: form.EndAt, Attributes: ariaInvalid(form.Errors["end_at"])})
		}
	}
}
