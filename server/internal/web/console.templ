package web

import (
	"cmp"
	"fmt"
	"strings"

	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/badge"
	"github.com/henriquepw/prata/server/internal/web/components/button"
	"github.com/henriquepw/prata/server/internal/web/components/field"
	"github.com/henriquepw/prata/server/internal/web/components/input"
	"github.com/henriquepw/prata/server/internal/web/components/nativeselect"
	"github.com/henriquepw/prata/server/internal/web/components/table"
)

// decodeScript scrambles every [data-decode] (panel titles and KPI values) into the text it was rendered with within
// 300ms, on load and after each htmx swap; digits stay digits and letters stay letters. Reduced motion leaves the
// value as rendered.
const decodeScript = `(() => {
  const scramble = c => /\d/.test(c) ? Math.random() * 10 | 0 : /\p{L}/u.test(c) ? 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'[Math.random() * 26 | 0] : c
  const decode = () => matchMedia('(prefers-reduced-motion: reduce)').matches || document.querySelectorAll('[data-decode]').forEach(e => {
    const value = e.textContent, start = performance.now()
    e.removeAttribute('data-decode')
    const step = now => {
      const n = Math.floor(Math.min(1, (now - start) / 300) * value.length)
      e.textContent = value.slice(0, n) + [...value.slice(n)].map(scramble).join('')
      if (n < value.length) requestAnimationFrame(step)
    }
    requestAnimationFrame(step)
  })
  addEventListener('DOMContentLoaded', decode)
  addEventListener('htmx:after:swap', decode)
})()`

// panel is the unit of every screen: the decoded title, the action on the right of it when not nil, and the content
// as children. class adds to .panel.
templ panel(title, class string, action templ.Component) {
	<section class={ "panel", class }>
		<header class="panel-head">
			<h2 class="panel-title">
				@decoded(title)
			</h2>
			if action != nil {
				@action
			}
		</header>
		{ children... }
	</section>
}

// kpi is a loose KPI box: the decoded amount over its label.
templ kpi(label string, cents int64) {
	<div class="kpi">
		<div class="kpi-value text-nowrap">
			@decoded(money(ctx, cents))
		</div>
		<div class="kpi-label">{ label }</div>
	</div>
}

// decoded is text that decodes on screen: screen readers read it from the sr-only copy and skip the scramble.
templ decoded(text string) {
	<span class="sr-only">{ text }</span><span aria-hidden="true" data-decode>{ text }</span>
}

// newAction is a list panel's "+ nova [n]": it opens the "novo" sheet at url.
templ newAction(url string) {
	@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"hx-get": url, "hx-target": "#sheet"}}) {
		{ i18n.T(ctx, "list.new") }
	}
}

// empty is a list's one-line empty state, as in "¯\_(ツ)_/¯ nenhuma categoria ainda".
templ empty(text string) {
	<p class="text-muted-foreground"><span aria-hidden="true">{ `¯\_(ツ)_/¯` }</span> { text }</p>
}

// sheetRow is a list row that opens its sheet at url on click or enter, flashing when it was just saved.
func sheetRow(url string, flash bool) table.RowProps {
	return table.RowProps{Attributes: templ.Attributes{"hx-get": url, "hx-target": "#sheet", "tabindex": "0", "data-flash": flash}}
}

// online is the server status of the ticker and the login footer, "● [online]"; the dot turns into the braille
// spinner, in CSS, while any htmx request is in flight.
templ online() {
	<span class="inline-flex items-center gap-[1ch]">
		<span class="sync-dot" aria-hidden="true"></span>
		@badge.Badge(badge.Props{Class: "bg-cat-green text-background"}) {
			[online]
		}
	</span>
}

const closeSheet = "this.closest('dialog').close()"

// sheetProps configures the form inside #sheet. DeleteURL, when set, adds "Excluir", which asks Confirm inline
// first, as in "excluir esta tag? <consequência>"; Error is a form-level message, such as a rejected commit. Submit
// and Busy name the submit and its spinner, "salvar" and "salvando" when empty.
type sheetProps struct {
	Title     string
	Action    string
	DeleteURL string
	Confirm   string
	Error     string
	Submit    string
	Busy      string
}

// sheet is the console sheet swapped into the #sheet dialog: a borderless panel with the title and [esc ✕], the
// fields as children, then "excluir" on the left and "cancelar" and "> salvar" on the right; while saving, the
// submit reads "⠋ salvando", and "excluir" swaps the footer for its confirmInline. Every response, a 422 included,
// swaps into #sheet.
templ sheet(p sheetProps) {
	<form hx-post={ p.Action } hx-target="#sheet" hx-disable="find [type=submit]" class="panel sheet-panel">
		<header class="panel-head">
			<h2 class="panel-title">{ p.Title }</h2>
			<button type="button" class="lnk" aria-label={ i18n.T(ctx, "sheet.close") } onclick={ templ.JSUnsafeFuncCall(closeSheet) }>[esc ✕]</button>
		</header>
		{ children... }
		if p.Error != "" {
			@field.Error() {
				{ p.Error }
			}
		}
		<footer class="mt-auto flex flex-wrap justify-between gap-[1ch]" data-confirm>
			<div>
				if p.DeleteURL != "" {
					@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantDestructive, Attributes: templ.Attributes{"onclick": templ.JSUnsafeFuncCall(toggleConfirm), "data-focus": true}}) {
						{ i18n.T(ctx, "sheet.delete") }
					}
				}
			</div>
			<div class="flex gap-[1ch]">
				@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"onclick": templ.JSUnsafeFuncCall(closeSheet)}}) {
					{ i18n.T(ctx, "sheet.cancel") }
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"data-busy": cmp.Or(p.Busy, i18n.T(ctx, "form.saving"))}}) {
					<span>&gt; { cmp.Or(p.Submit, i18n.T(ctx, "form.save")) }</span>
				}
			</div>
			if p.DeleteURL != "" {
				@confirmInline(p.Confirm, i18n.T(ctx, "sheet.confirm_delete"), templ.Attributes{"hx-delete": p.DeleteURL, "hx-target": "#sheet"})
			}
		</footer>
	</form>
}

// toggleConfirm swaps the children of the closest [data-confirm] between the actions and the inline confirmation,
// focusing the [data-focus] left visible: "não" while asking, the button that asked after it.
const toggleConfirm = "const c = this.closest('[data-confirm]'); for (const e of c.children) e.hidden = !e.hidden; [...c.querySelectorAll('[data-focus]')].find(e => e.checkVisibility()).focus()"

// confirmInline is the hidden "! <question> [sim, …] [não]" that toggleConfirm swaps in for the actions of the
// closest [data-confirm], without a round-trip: yes carries the request in attrs, "não" swaps back.
templ confirmInline(question, yes string, attrs templ.Attributes) {
	<div class="inline-flex flex-wrap items-center gap-[1ch]" hidden>
		<span class="text-xs text-destructive">! { question }</span>
		@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantDestructive, Size: button.SizeSm, Attributes: attrs}) {
			{ yes }
		}
		@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"onclick": templ.JSUnsafeFuncCall(toggleConfirm), "data-focus": true}}) {
			{ i18n.T(ctx, "confirm.no") }
		}
	</div>
}

// hintField is one sheet field: label, the control as children, then the hint as a muted line under it or, in its
// place, the error message.
templ hintField(id, label, hint, message string) {
	@field.Field() {
		@field.Label(field.LabelProps{For: id}) {
			{ label }
		}
		{ children... }
		@fieldNote(hint, message)
	}
}

// fieldNote is the line under a field: the error message when there is one, else the hint.
templ fieldNote(hint, message string) {
	if message != "" {
		@field.Error() {
			{ message }
		}
	} else if hint != "" {
		<p class="text-[11px] text-muted-foreground">{ hint }</p>
	}
}

// amountField is the required amount of an entry, after the currency symbol, focused when the sheet opens, with the
// hint under it when not empty.
templ amountField(value, hint, message string) {
	@hintField("amount", i18n.T(ctx, "field.amount"), hint, message) {
		@currencyPrefix() {
			@input.Input(input.Props{ID: "amount", Name: "amount", Value: value, Placeholder: amount(ctx, 0), Required: true, Class: "tabular-nums", Attributes: ariaInvalid(message, templ.Attributes{"inputmode": "decimal", "autocomplete": "off", "autofocus": true})})
		}
	}
}

// nameField is the required name of a category or tag, focused when the sheet opens.
templ nameField(value, message string) {
	@formField("name", i18n.T(ctx, "field.name"), message) {
		@input.Input(input.Props{ID: "name", Name: "name", Value: value, Required: true, Attributes: ariaInvalid(message, templ.Attributes{"autofocus": true})})
	}
}

// categoryField is the category of an entry, picked from categories after "sem categoria", with selected picked.
templ categoryField(categories []store.Category, selected, message string) {
	@formField("category_id", i18n.T(ctx, "field.category"), message) {
		@nativeselect.NativeSelect(nativeselect.Props{ID: "category_id", Name: "category_id", Class: "w-full", Attributes: ariaInvalid(message)}) {
			@nativeselect.Option(nativeselect.OptionProps{Value: "", Selected: selected == ""}) {
				{ i18n.T(ctx, "field.no_category") }
			}
			for _, category := range categories {
				@nativeselect.Option(nativeselect.OptionProps{Value: category.ID, Selected: category.ID == selected}) {
					{ category.Name }
				}
			}
		}
	}
}

// endField is the optional end date of a tag or recurrence, "vazio = sem fim".
templ endField(value, message string) {
	@hintField("end_at", i18n.T(ctx, "field.end"), i18n.T(ctx, "field.end_hint"), message) {
		@input.Input(input.Props{ID: "end_at", Name: "end_at", Type: "date", Value: value, Attributes: ariaInvalid(message)})
	}
}

// fillDate sets the date input id to today minus days, in the browser's time zone.
func fillDate(id string, days int) string {
	return fmt.Sprintf("const d = new Date(); d.setDate(d.getDate() - %d); document.getElementById('%s').value = d.toLocaleDateString('sv')", days, id)
}

// dateField is the required date of an entry, with [hoje] [ontem] beside its label filling it without opening the
// date picker.
templ dateField(id, label, value, message string) {
	@field.Field() {
		<div class="flex items-center justify-between gap-[1ch]">
			@field.Label(field.LabelProps{For: id}) {
				{ label }
			}
			<span class="flex gap-[.5ch]">
				<button type="button" class="lnk" onclick={ templ.JSUnsafeFuncCall(fillDate(id, 0)) }>[{ i18n.T(ctx, "date.today") }]</button>
				<button type="button" class="lnk" onclick={ templ.JSUnsafeFuncCall(fillDate(id, 1)) }>[{ i18n.T(ctx, "date.yesterday") }]</button>
			</span>
		</div>
		@input.Input(input.Props{ID: id, Name: id, Type: "date", Value: value, Required: true, Attributes: ariaInvalid(message)})
		@fieldNote("", message)
	}
}

// choiceField is a short choice, as in [despesa] [receita]: the choiceOption radios as children, drawn as buttons
// with the checked one inverted.
templ choiceField(name, label, message string) {
	@field.Field() {
		<span id={ name + "-label" } class="text-[11px] uppercase tracking-widest text-muted-foreground">{ label }</span>
		<div role="radiogroup" aria-labelledby={ name + "-label" } class="choice" { ariaInvalid(message)... }>
			{ children... }
		</div>
		@fieldNote("", message)
	}
}

// choiceOption is one radio of a choiceField, with its label as children inside the brackets.
templ choiceOption(name, value string, checked bool) {
	<label>
		<input type="radio" name={ name } value={ value } checked?={ checked }/>
		<span>
			[{ children... }
			]
		</span>
	</label>
}

// kindChoice is the [despesa] [receita] choice of a transaction or recurrence.
templ kindChoice(value, message string) {
	@choiceField("kind", i18n.T(ctx, "kind.label"), message) {
		for _, kind := range kinds {
			@choiceOption("kind", kind, kind == value) {
				{ strings.ToLower(i18n.T(ctx, "kind."+kind)) }
			}
		}
	}
}

// description is an entry's description, or "sem descrição" in muted italics when it has none.
templ description(text *string) {
	if orEmpty(text) == "" {
		<span class="italic text-muted-foreground">{ i18n.T(ctx, "field.no_description") }</span>
	} else {
		{ *text }
	}
}
