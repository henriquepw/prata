package homepage

import (
	"context"
	"github.com/henriquepw/prata/server/internal/web/components/console"
	"github.com/henriquepw/prata/server/internal/web/components/shell"
	"strconv"
	"strings"
	"time"

	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/badge"
	"github.com/henriquepw/prata/server/internal/web/components/button"
	"github.com/henriquepw/prata/server/internal/web/components/table"
	"github.com/henriquepw/prata/server/internal/web/form"
	"github.com/henriquepw/prata/server/internal/web/prefs"
	"github.com/henriquepw/prata/server/internal/web/utils"
)

const meterSegments = 20

// meter is the color class of each of the 20 segments of a category's usage: the used share of the limit in the
// category's color and, past the limit, the limit's share in color (19 at most) and the excess in destructive; all
// empty, in --line-soft, without a limit.
func meter(usage store.CategoryUsage) []string {
	segments := make([]string, meterSegments)
	for i := range segments {
		segments[i] = "text-line-soft"
	}

	if usage.MonthlyLimit == 0 {
		return segments
	}

	isOver := usage.Used > usage.MonthlyLimit
	on := (usage.Used*meterSegments + usage.MonthlyLimit/2) / usage.MonthlyLimit
	if isOver {
		on = min(meterSegments-1, (usage.MonthlyLimit*meterSegments+usage.Used/2)/usage.Used)
	}

	for i := range segments {
		switch {
		case int64(i) < on:
			segments[i] = console.ColorClass(usage.Color)
		case isOver:
			segments[i] = "text-destructive"
		}
	}

	return segments
}

// percent is the rounded share of the limit a category used, or "∞" without a limit.
func percent(usage store.CategoryUsage) string {
	if usage.MonthlyLimit == 0 {
		return "∞"
	}

	return strconv.FormatInt((usage.Used*100+usage.MonthlyLimit/2)/usage.MonthlyLimit, 10) + "%"
}

// monthKeys is the month's hint in a panel slot, as "/ focus · enter add": muted caps with the keys in primary.
const monthKeys = "text-2xs tracking-wider text-muted-foreground uppercase [&_kbd]:text-primary"

// statementDay is a cell of a statement's day line: muted caps over a --line-soft border.
const statementDay = "border-b border-line-soft px-2 pt-5 pb-1.5 text-2xs tracking-widest text-muted-foreground uppercase"

// dailyDay is a cell of the daily limit grid: its tone's border when red, faded when gray, outlined in primary when
// today and lifted with a --foreground border on hover or focus, which shows its tooltip.
const dailyDay = "group relative flex min-w-0 flex-col gap-0.5 border border-line-faint px-2 pt-2.5 pb-4 text-2xs outline-none hover:z-5 hover:border-foreground focus-visible:z-5 focus-visible:border-foreground data-today:outline data-today:outline-solid data-today:outline-offset-1 data-today:outline-primary data-[tone=red]:border-destructive data-[tone=gray]:*:not-[[role=tooltip]]:opacity-55"

// dailyTipBox is a day's tooltip: console.Inverted above the cell, centered or held inside the grid on the edge columns.
const dailyTipBox = "pointer-events-none absolute bottom-full left-1/2 z-10 mb-1.5 flex w-67 -translate-x-1/2 flex-col gap-1 bg-foreground px-3 py-3 text-background opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100 group-data-[edge=start]:left-0 group-data-[edge=start]:translate-x-0 group-data-[edge=end]:right-0 group-data-[edge=end]:left-auto group-data-[edge=end]:translate-x-0"

// tightTable narrows a wide table's cell padding on mobile, spelled out here for Tailwind.
const tightTable = "@max-2xl/console:[&_:is(td,th)]:px-1"

// shortDay writes a pure "YYYY-MM-DD" date without the year in the request's date format, as "19/11".
func shortDay(ctx context.Context, date string) string {
	t, _ := time.Parse(time.DateOnly, date)

	return t.Format(strings.Trim(strings.ReplaceAll(prefs.DateLayout(ctx), "2006", ""), "/-"))
}

// monthURL is the Month of month, as YYYY-MM, with the statement narrowed to category when it is not empty.
func monthURL(month, category string) string {
	if category == "" {
		return "/?month=" + month
	}

	return "/?month=" + month + "&category=" + category
}

// narrow is the attributes of a link that changes the category filter in place: it fetches url and swaps only the
// statement and categories grid (and the month bar, whose links carry the filter), keeping the URL in the history.
func narrow(url string) templ.Attributes {
	return templ.Attributes{"hx-get": url, "hx-target": "#breakdown", "hx-select": "#breakdown", "hx-select-oob": "#month-bar", "hx-swap": "outerHTML", "hx-push-url": "true"}
}

// monthOffset is month offset months away, as YYYY-MM.
func monthOffset(month time.Time, offset int) string {
	return month.AddDate(0, offset, 0).Format(monthLayout)
}

// monthPage is the Month: the month bar over the boxes and the statement, which a confirmation on a row swaps.
templ monthPage(s shell.Shell, page month) {
	@shell.Layout(s) {
		@monthBar(page)
		@monthContent(page)
	}
}

// monthSwap is the answer of a write in place: the month, with the ticker and the balance line out of band.
templ monthSwap(s shell.Shell, page month) {
	@monthContent(page)
	@shell.Ticker(s, true)
	@shell.BalanceLine(s.Balance, true)
}

// monthBar is "‹ November 2026 ›", with "[this month]" away from it and the [ ] keys on the right.
templ monthBar(page month) {
	<div id="month-bar" class="mb-5 flex items-center justify-between gap-4">
		<div class="flex items-center gap-2">
			<a href={ templ.SafeURL(monthURL(monthOffset(page.Month, -1), page.Filter.ID)) } class={ console.TextAction } data-key="[" aria-label={ i18n.T(ctx, "month.previous") }>‹</a>
			<span class="min-w-38 text-center tracking-widest uppercase">{ i18n.T(ctx, "month.year", i18n.T(ctx, "month."+page.Month.Month().String()), page.Month.Year()) }</span>
			<a href={ templ.SafeURL(monthURL(monthOffset(page.Month, 1), page.Filter.ID)) } class={ console.TextAction } data-key="]" aria-label={ i18n.T(ctx, "month.next") }>›</a>
			if !page.isCurrent() {
				<a href={ templ.SafeURL(monthURL(page.Today[:len(monthLayout)], page.Filter.ID)) } class={ console.TextAction }>{ i18n.T(ctx, "month.current") }</a>
			}
		</div>
	</div>
}

var weekdays = []string{"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"}

// dailyBudget is the slot of the daily limit panel: the daily limit mode and the budget it spreads over the month.
templ dailyBudget(d daily) {
	if d.Defined {
		<span class={ monthKeys }>{ i18n.T(ctx, "month.daily_budget", prefs.Money(ctx, d.Budget)) }</span>
	}
}

// dailyCalendar is the month as a week-wide grid under the weekdays: a cell per day with its spent, its limit and a
// meter of the share, today marked, and a tooltip on hover or focus with what was left or went over and how the limit
// is made; the legend of the tones below.
templ dailyCalendar(page month) {
	<ol class="grid grid-cols-7 gap-1">
		for _, weekday := range weekdays {
			<li class="pb-1.5 text-2xs tracking-widest text-muted-foreground uppercase" aria-hidden="true">{ i18n.T(ctx, "weekday."+weekday) }</li>
		}
		for range page.Daily.Lead {
			<li aria-hidden="true"></li>
		}
		for _, cell := range page.Daily.Cells {
			{{ column := (page.Daily.Lead + cell.Day - 1) % 7 }}
			<li
				class={ dailyDay }
				data-date={ cell.Date }
				data-tone={ cell.Tone }
				data-today?={ cell.Date == page.Today }
				data-edge={ utils.IfElse(column < 3, "start", utils.IfElse(column > 4, "end", "")) }
				tabindex="0"
				aria-describedby={ "daily-tip-" + cell.Date }
			>
				<b class="font-medium text-muted-foreground group-data-today:text-primary group-data-today:before:content-['▌']">{ strconv.Itoa(cell.Day) }</b>
				<span class="truncate text-xs font-semibold tabular-nums group-data-[tone=gray]:font-normal">{ prefs.Money(ctx, cell.Spent) }</span>
				<span class="truncate tabular-nums before:content-['/_'] text-muted-foreground">{ prefs.Money(ctx, cell.Limit) }</span>
				<i class="absolute bottom-0 left-0 h-1 w-(--w) bg-(--tone)" style={ "--w: " + strconv.FormatInt(min(100, cell.percent()), 10) + "%" }></i>
				@dailyTip(page, cell)
			</li>
		}
	</ol>
	<p class="mt-5 flex flex-wrap gap-x-4 text-2xs text-muted-foreground *:before:text-(--tone) *:before:content-['■_']">
		for _, tone := range []string{"green", "yellow", "red", "gray"} {
			<span data-tone={ tone }>{ i18n.T(ctx, "month.daily_"+tone) }</span>
		}
	</p>
}

// dailyTip is the tooltip of a day: its date, spent and limit, what was left or went over with the share, nothing of
// that for a day still to come, and how the daily limit mode makes the limit.
templ dailyTip(page month, cell dailyCell) {
	<span id={ "daily-tip-" + cell.Date } role="tooltip" class={ dailyTipBox }>
		<strong>{ i18n.T(ctx, "weekday."+dayOf(cell.Date).Weekday().String()) } { shortDay(ctx, cell.Date) }</strong>
		<span>{ i18n.T(ctx, "month.daily_spent", prefs.Money(ctx, cell.Spent)) }</span>
		<span>{ i18n.T(ctx, "month.daily_limit", prefs.Money(ctx, cell.Limit)) }</span>
		switch  {
			case cell.Date > page.Today:
				<span>{ i18n.T(ctx, "month.daily_future") }</span>
			case cell.Spent <= cell.Limit:
				<span>{ i18n.T(ctx, "month.daily_left", prefs.Money(ctx, cell.Limit-cell.Spent), cell.percent()) }</span>
			default:
				<span>{ i18n.T(ctx, "month.daily_over", prefs.Money(ctx, cell.Spent-cell.Limit), cell.percent()) }</span>
		}
		<span>{ i18n.T(ctx, "month.daily_how_"+page.Daily.Mode) }</span>
	</span>
}

// monthContent is the six boxes of the month's account and the grid of the statement and the categories.
templ monthContent(page month) {
	<div id="month" class="flex flex-col gap-5">
		if page.Error != "" {
			<p role="alert" class="text-destructive">! { page.Error }</p>
		}
		<div class="flex flex-wrap gap-3 *:nth-4:border-line *:nth-6:border-line *:nth-6:text-primary">
			@console.Kpi(i18n.T(ctx, "month.previous_balance"), page.Previous)
			@console.Kpi(i18n.T(ctx, "month.income"), page.Income)
			@console.Kpi(i18n.T(ctx, "month.outcome"), -page.Outcome)
			@console.Kpi(i18n.T(ctx, "month.realized"), page.realized())
			@console.Kpi(i18n.T(ctx, "month.pending"), page.Pending)
			@console.Kpi(i18n.T(ctx, "month.projected"), page.realized()+page.Pending)
		</div>
		@launchPanel(page)
		@console.Panel(i18n.T(ctx, "month.daily"), "", dailyBudget(page.Daily)) {
			if !page.Daily.Defined {
				@console.Empty(i18n.T(ctx, "month.daily_empty"))
			} else {
				@dailyCalendar(page)
			}
		}
		<div id="breakdown" class="flex flex-wrap gap-x-4 gap-y-5">
			@console.Panel(i18n.T(ctx, "month.statement"), "min-w-0 grow-3 basis-101", statementActions(page)) {
				if len(page.Days) == 0 && len(page.Overdue) == 0 {
					@console.Empty(i18n.T(ctx, utils.IfElse(page.Filter.ID == "", "month.empty", "month.empty_category")))
				} else {
					@table.Table(table.Props{Class: tightTable}) {
						@table.Body() {
							for i, d := range page.Days {
								if i == page.TodayAt {
									@todayLine(page)
								}
								<tr>
									<td colspan="3" class={ statementDay }>{ i18n.T(ctx, "weekday."+dayOf(d.Date).Weekday().String()) } { shortDay(ctx, d.Date) }</td>
									<td class={ statementDay, "text-right tabular-nums" }>
										if len(d.Transactions) > 0 {
											{ prefs.Money(ctx, d.Total) }
										}
									</td>
								</tr>
								for _, p := range d.Pending {
									@pendingRow(page, p, false)
								}
								for _, t := range d.Transactions {
									@table.Row(console.SheetRow("/transactions/"+t.ID, t.ID == page.Flash)) {
										@table.Cell(table.CellProps{Class: "w-full whitespace-normal"}) {
											@console.Description(t.Description)
										}
										@table.Cell(table.CellProps{Class: "@max-2xl/console:hidden"}) {
											if t.CategoryName != "" {
												@console.CategoryName(t.CategoryName, t.CategoryColor)
											}
										}
										@table.Cell(table.CellProps{Class: "@max-2xl/console:hidden text-muted-foreground"}) {
											if t.TagName != "" {
												{ "#" + t.TagName }
											}
										}
										@table.Cell(table.CellProps{Class: utils.CN("text-right tabular-nums", console.KindClass(t.Kind))}) {
											{ prefs.Money(ctx, form.Signed(t.Kind, t.Amount)) }
										}
									}
								}
							}
							if page.TodayAt == len(page.Days) {
								@todayLine(page)
							}
						}
					}
					if page.More {
						<a href={ templ.SafeURL(monthURL(page.yearMonth(), page.Filter.ID) + "&limit=" + strconv.Itoa(page.Limit+statementPage)) } class={ console.TextAction, "mt-2 block text-center" }>{ i18n.T(ctx, "month.more") }</a>
					}
				}
			}
			@console.Panel(i18n.T(ctx, "nav.categories"), "min-w-0 grow basis-59", allCategories(page)) {
				if len(page.Usages) == 0 {
					@console.Empty(i18n.T(ctx, "categories.empty"))
				} else {
					<div class="flex flex-col">
						for _, usage := range page.Usages {
							{{ isOver := usage.MonthlyLimit > 0 && usage.Used > usage.MonthlyLimit }}
							<a
								href={ templ.SafeURL(monthURL(page.yearMonth(), usage.ID)) }
								{ narrow(monthURL(page.yearMonth(), usage.ID))... }
								class="grid grid-cols-[1fr_auto] items-center gap-x-2 gap-y-1 border-l-3 border-transparent px-2 py-2.5 transition-colors hover:bg-line-soft aria-current:border-primary aria-current:bg-line-soft"
								if usage.ID == page.Filter.ID {
									aria-current="true"
								}
							>
								@console.CategoryName(usage.Name, usage.Color)
								<b class={ "text-xs tabular-nums", templ.KV("text-destructive", isOver), templ.KV("text-muted-foreground", !isOver) }>{ percent(usage) }</b>
								<span class="col-span-full flex h-2 gap-0.5" aria-hidden="true">
									for _, segment := range meter(usage) {
										<i class={ "flex-1 bg-current", segment }></i>
									}
								</span>
							</a>
						}
					</div>
				}
			}
		</div>
	</div>
}

// statementActions is the statement's filter, "■ mercado ✕", which clears it, and "+ nova".
templ statementActions(page month) {
	<span class="flex items-center gap-2">
		if page.Filter.ID != "" {
			<a href={ templ.SafeURL(monthURL(page.yearMonth(), "")) } { narrow(monthURL(page.yearMonth(), ""))... } class={ console.TextAction, "flex items-center gap-2" }>
				@console.CategoryName(page.Filter.Name, page.Filter.Color)
				✕
			</a>
		}
		@console.NewAction("/transactions/new")
	</span>
}

// allCategories is "[todas]", which clears the filter, only while there is one.
templ allCategories(page month) {
	if page.Filter.ID != "" {
		<a href={ templ.SafeURL(monthURL(page.yearMonth(), "")) } { narrow(monthURL(page.yearMonth(), ""))... } class={ console.TextAction }>{ i18n.T(ctx, "month.all") }</a>
	}
}

// dayOf is a pure "YYYY-MM-DD" date at midnight UTC.
func dayOf(date string) time.Time {
	t, _ := time.Parse(time.DateOnly, date)

	return t
}

// todayLine is "── hoje · 19/11 ──", with the overdue occurrences of earlier months under it.
templ todayLine(page month) {
	<tr>
		<td colspan="4" class="bg-primary/8 px-2 py-2 text-center text-2xs tracking-widest text-primary uppercase">── { i18n.T(ctx, "month.today") } · { shortDay(ctx, page.Today) } ──</td>
	</tr>
	for _, p := range page.Overdue {
		@pendingRow(page, p, true)
	}
}

// pendingRow is a pending occurrence in the statement, with its date when withDate: muted, its [pendente] or
// [overdue] chip and "confirmar", which swaps the month in place. The row itself opens "confirm occurrence".
templ pendingRow(page month, p shell.Occurrence, withDate bool) {
	{{ url := "/recurrences/" + p.Recurrence.ID + "/occurrences/" + p.Date }}
	@table.Row(table.RowProps{Class: "*:text-muted-foreground", Attributes: console.SheetRow(url, false).Attributes}) {
		@table.Cell(table.CellProps{Class: "w-full whitespace-normal"}) {
			if withDate {
				<span class="tabular-nums">{ shortDay(ctx, p.Date) }</span>
			}
			@console.Description(p.Recurrence.Description)
			if p.Overdue {
				@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
					{ i18n.T(ctx, "month.overdue") }
				}
			} else {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					{ i18n.T(ctx, "month.pending_chip") }
				}
			}
		}
		@table.Cell(table.CellProps{Class: "@max-2xl/console:hidden"}) {
			for _, usage := range page.Usages {
				if usage.ID == form.OrEmpty(p.Recurrence.CategoryID) {
					@console.CategoryName(usage.Name, usage.Color)
				}
			}
		}
		@table.Cell(table.CellProps{Class: "@max-2xl/console:hidden"}) {
			<form hx-post={ url } hx-target="#month" hx-swap="outerHTML" onclick="event.stopPropagation()" class="flex justify-end">
				<input type="hidden" name="month" value={ page.yearMonth() }/>
				<input type="hidden" name="category" value={ page.Filter.ID }/>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-busy": i18n.T(ctx, "form.confirming")}}) {
					<span>{ i18n.T(ctx, "month.confirm") }</span>
				}
			</form>
		}
		@table.Cell(table.CellProps{Class: utils.CN("text-right tabular-nums opacity-70", console.KindClass(p.Recurrence.Kind))}) {
			{ prefs.Money(ctx, form.Signed(p.Recurrence.Kind, p.Recurrence.Amount)) }
		}
	}
}
