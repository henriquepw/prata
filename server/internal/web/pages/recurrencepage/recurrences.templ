package recurrencepage

import (
	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/console"
	"github.com/henriquepw/prata/server/internal/web/components/input"
	"github.com/henriquepw/prata/server/internal/web/components/shell"
	"github.com/henriquepw/prata/server/internal/web/components/table"
	"github.com/henriquepw/prata/server/internal/web/form"
	"github.com/henriquepw/prata/server/internal/web/prefs"
	"github.com/henriquepw/prata/server/internal/web/utils"
)

// recurrenceForm is the recurrence sheet: what the user typed, the categories to pick from and an error
// message per field name, "form" holding a rejected commit.
type recurrenceForm struct {
	ID          string
	Description string
	Kind        string
	Amount      string
	CategoryID  string
	Day         string
	StartAt     string
	EndAt       string
	Categories  []store.Category
	Errors      map[string]string
}

templ recurrencesPage(s shell.Shell, recurrences []store.Recurrence) {
	@shell.Layout(s) {
		@console.Panel(i18n.T(ctx, "nav.recurrences"), "", console.NewAction("/recurrences/new")) {
			if len(recurrences) == 0 {
				@console.Empty(i18n.T(ctx, "recurrences.empty"))
			} else {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head(table.HeadProps{Class: "w-full"}) {
								{ i18n.T(ctx, "field.description") }
							}
							@table.Head() {
								{ i18n.T(ctx, "recurrences.day") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "field.amount") }
							}
						}
					}
					@table.Body() {
						for _, recurrence := range recurrences {
							@table.Row(console.SheetRow("/recurrences/"+recurrence.ID, recurrence.ID == s.Flash)) {
								@table.Cell(table.CellProps{Class: "whitespace-normal"}) {
									@console.Description(recurrence.Description)
								}
								@table.Cell(table.CellProps{Class: "tabular-nums text-muted-foreground"}) {
									{ i18n.T(ctx, "recurrences.every_month", ruleDay(recurrence.Rule)) }
								}
								@table.Cell(table.CellProps{Class: utils.CN("text-right tabular-nums", console.KindClass(recurrence.Kind))}) {
									{ prefs.Money(ctx, form.Signed(recurrence.Kind, recurrence.Amount)) }
								}
							}
						}
					}
				}
			}
		}
	}
}

templ recurrenceSheet(form recurrenceForm) {
	@console.Sheet(console.SheetProps{
		Title:     i18n.T(ctx, utils.IfElse(form.ID == "", "recurrences.new", "recurrences.edit")),
		Action:    utils.IfElse(form.ID == "", "/recurrences", "/recurrences/"+form.ID),
		DeleteURL: utils.IfElse(form.ID == "", "", "/recurrences/"+form.ID),
		Confirm:   i18n.T(ctx, "recurrences.confirm_delete"),
		Error:     form.Errors["form"],
	}) {
		@console.KindChoice(form.Kind, form.Errors["kind"])
		@console.AmountField(form.Amount, "", form.Errors["amount"])
		@console.FormField("description", i18n.T(ctx, "field.description"), form.Errors["description"]) {
			@input.Input(input.Props{ID: "description", Name: "description", Value: form.Description})
		}
		<div class="grid grid-cols-2 gap-4">
			@console.HintField("day", i18n.T(ctx, "recurrences.day"), i18n.T(ctx, "recurrences.day_hint"), form.Errors["day"]) {
				@input.Input(input.Props{ID: "day", Name: "day", Type: "number", Value: form.Day, Required: true, Attributes: console.AriaInvalid(form.Errors["day"], templ.Attributes{"min": 1, "max": 31})})
			}
			@console.CategoryField(form.Categories, form.CategoryID, form.Errors["category_id"])
		</div>
		<div class="grid grid-cols-2 gap-4">
			@console.FormField("start_at", i18n.T(ctx, "field.start"), form.Errors["start_at"]) {
				@input.Input(input.Props{ID: "start_at", Name: "start_at", Type: "date", Value: form.StartAt, Required: true, Attributes: console.AriaInvalid(form.Errors["start_at"])})
			}
			@console.EndField(form.EndAt, form.Errors["end_at"])
		</div>
	}
}
