package devicepage

import (
	"context"
	"github.com/henriquepw/prata/server/internal/web/components/console"
	"time"

	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/prefs"
)

// activityPhrase is what an op did, such as `transação "Uber" criada`, without the quoted label when it has none.
func activityPhrase(ctx context.Context, a store.Activity) string {
	phrase := i18n.T(ctx, "activity.entity."+a.Entity)
	if a.Label != "" {
		phrase += ` "` + a.Label + `"`
	}

	return phrase + " " + i18n.T(ctx, "activity.kind."+string(a.Kind))
}

// activityLog is the "Log de atividade" panel: one line per op, newest first, with the time in loc, and the
// prompt pinned to the bottom.
templ activityLog(activity []store.Activity, loc *time.Location) {
	@console.Panel(i18n.T(ctx, "activity.title"), "flex min-w-0 grow basis-59 flex-col", nil) {
		<ol class="flex flex-1 flex-col text-xs/5">
			for _, a := range activity {
				<li><span class="text-muted-foreground">{ "> [" + prefs.FormatDate(a.CreatedAt, loc, "15:04") + "]" }</span> { a.Device } · { activityPhrase(ctx, a) }</li>
			}
			if len(activity) == 0 {
				<li>@console.Empty(i18n.T(ctx, "activity.empty"))</li>
			}
			<li class="mt-auto" aria-hidden="true"><span class="text-muted-foreground">{ ">" }</span> <span class="animate-blink text-primary">▋</span></li>
		</ol>
	}
}
