package settingpage

import (
	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/web/components/settingform"
	"github.com/henriquepw/prata/server/internal/web/components/button"
	"github.com/henriquepw/prata/server/internal/web/components/console"
	"github.com/henriquepw/prata/server/internal/web/components/input"
	"github.com/henriquepw/prata/server/internal/web/components/nativeselect"
	"github.com/henriquepw/prata/server/internal/web/shared"
)

// sheet is the Configurações sheet: the fields in one list and "> salvar", the Pluggy credentials last when
// Open Finance is on. A 422 swaps the whole sheet.
templ sheet(form settingform.Form) {
	@console.Sheet(console.SheetProps{Title: i18n.T(ctx, "nav.settings"), Action: "/settings"}) {
		@settingform.LanguageField(form)
		@settingform.DateFormatField(form)
		@settingform.NumberFormatField(form)
		@console.FormField("daily_limit_mode", i18n.T(ctx, "settings.daily_limit_mode"), form.Errors["daily_limit_mode"]) {
			@nativeselect.NativeSelect(nativeselect.Props{ID: "daily_limit_mode", Name: "daily_limit_mode", Class: "w-full", Attributes: console.AriaInvalid(form.Errors["daily_limit_mode"])}) {
				for _, m := range shared.DailyLimitModes {
					@nativeselect.Option(nativeselect.OptionProps{Value: m.Value, Selected: m.Value == form.DailyLimitMode}) {
						{ i18n.T(ctx, "daily_limit_mode."+m.Value) }
					}
				}
			}
		}
		@settingform.CurrencyField(form)
		if form.OpenFinance {
			@pluggyFields(form)
		}
	}
}

// pluggyFields are the user's Pluggy client id and secret, with "apagar credenciais" and its inline confirmation
// when they are saved.
templ pluggyFields(form settingform.Form) {
	@console.HintField("pluggy_client_id", i18n.T(ctx, "settings.pluggy_client_id"), i18n.T(ctx, "settings.pluggy_hint"), form.Errors["pluggy_client_id"]) {
		@input.Input(input.Props{ID: "pluggy_client_id", Name: "pluggy_client_id", Value: form.PluggyClientID, Attributes: console.AriaInvalid(form.Errors["pluggy_client_id"], templ.Attributes{"autocomplete": "off"})})
	}
	@console.HintField("pluggy_client_secret", i18n.T(ctx, "settings.pluggy_client_secret"), secretHint(ctx, form.HasPluggy), form.Errors["pluggy_client_secret"]) {
		@input.Input(input.Props{ID: "pluggy_client_secret", Name: "pluggy_client_secret", Type: "password", Attributes: console.AriaInvalid(form.Errors["pluggy_client_secret"], templ.Attributes{"autocomplete": "off"})})
	}
	if form.HasPluggy {
		<div class="flex flex-wrap gap-2" data-confirm>
			@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantDestructive, Size: button.SizeSm, Attributes: templ.Attributes{"onclick": templ.JSUnsafeFuncCall(console.ToggleConfirm), "data-focus": true}}) {
				{ i18n.T(ctx, "settings.pluggy_delete") }
			}
			@console.ConfirmInline(i18n.T(ctx, "settings.pluggy_confirm"), i18n.T(ctx, "sheet.confirm_delete"), templ.Attributes{"hx-delete": "/settings/pluggy", "hx-target": "#sheet"})
		</div>
	}
}
