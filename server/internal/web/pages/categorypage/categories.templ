package categorypage

import (
	"github.com/henriquepw/prata/server/internal/web/components/budget"
	"github.com/henriquepw/prata/server/internal/web/components/console"
	"github.com/henriquepw/prata/server/internal/web/components/shell"
	"strings"

	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/web/utils"
)

// categoryForm is the category sheet: what the user typed and an error message per field name,
// "form" holding a rejected commit.
type categoryForm struct {
	ID          string
	Name        string
	Color       string
	IsDaily     bool
	IsDefault   bool
	MarkDefault bool
	Errors      map[string]string
}

// categoriesPage is the Categorias screen, which is the division of the Receita mensal (budget.Screen).
templ categoriesPage(s shell.Shell, form budget.Form) {
	@shell.Layout(s) {
		@budget.Screen(form, s.Flash)
	}
}

templ categorySheet(form categoryForm) {
	@console.Sheet(console.SheetProps{
		Title:     i18n.T(ctx, utils.IfElse(form.ID == "", "categories.new", "categories.edit")),
		Action:    utils.IfElse(form.ID == "", "/categories", "/categories/"+form.ID),
		DeleteURL: utils.IfElse(form.ID == "" || form.IsDefault, "", "/categories/"+form.ID),
		Confirm:   i18n.T(ctx, "categories.confirm_delete"),
		Error:     form.Errors["form"],
	}) {
		@console.NameField(form.Name, form.Errors["name"])
		@console.ChoiceField("color", i18n.T(ctx, "categories.color"), "", form.Errors["color"]) {
			for _, color := range console.CategoryColors {
				@console.ChoiceOption("color", color.Value, color.Value == form.Color) {
					<span class={ color.Class } aria-hidden="true">■</span> { strings.ToLower(i18n.T(ctx, "color."+color.Value)) }
				}
			}
		}
		@console.ChoiceField("is_daily", i18n.T(ctx, "categories.daily"), i18n.T(ctx, "categories.daily_help"), "") {
			@console.ChoiceOption("is_daily", "1", form.IsDaily) {
				{ i18n.T(ctx, "categories.yes") }
			}
			@console.ChoiceOption("is_daily", "0", !form.IsDaily) {
				{ i18n.T(ctx, "categories.no") }
			}
		}
		<fieldset class="contents" disabled?={ form.IsDefault }>
			@console.ChoiceField("is_default", i18n.T(ctx, "categories.default"), i18n.T(ctx, "categories.default_help"), "") {
				@console.ChoiceOption("is_default", "1", form.IsDefault || form.MarkDefault) {
					{ i18n.T(ctx, "categories.yes") }
				}
				@console.ChoiceOption("is_default", "0", !form.IsDefault && !form.MarkDefault) {
					{ i18n.T(ctx, "categories.no") }
				}
			}
		</fieldset>
	}
}
