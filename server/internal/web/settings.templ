package web

import (
	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/button"
	"github.com/henriquepw/prata/server/internal/web/components/field"
	"github.com/henriquepw/prata/server/internal/web/components/input"
	"github.com/henriquepw/prata/server/internal/web/components/nativeselect"
)

// settingsForm is the Configurações sheet: the Preferences and the account's Moeda shown or typed and an error message
// per field name. With OpenFinance on, it also has the Pluggy client id, never the secret, and whether credentials
// are saved.
type settingsForm struct {
	store.Preferences
	Currency       string
	OpenFinance    bool
	PluggyClientID string
	HasPluggy      bool
	Errors         map[string]string
}

// settingsSheet is the Configurações sheet: the fields in one list and "> salvar", the Pluggy credentials last when
// Open Finance is on. A 422 swaps the whole sheet.
templ settingsSheet(form settingsForm) {
	@sheet(sheetProps{Title: i18n.T(ctx, "nav.settings"), Action: "/settings"}) {
		@formField("language", i18n.T(ctx, "settings.language"), form.Errors["language"]) {
			@nativeselect.NativeSelect(nativeselect.Props{ID: "language", Name: "language", Class: "w-full", Attributes: ariaInvalid(form.Errors["language"])}) {
				for _, l := range languages {
					@nativeselect.Option(nativeselect.OptionProps{Value: l.Value, Selected: l.Value == form.Language}) {
						{ l.Label }
					}
				}
			}
		}
		@formField("date_format", i18n.T(ctx, "settings.date_format"), form.Errors["date_format"]) {
			@nativeselect.NativeSelect(nativeselect.Props{ID: "date_format", Name: "date_format", Class: "w-full", Attributes: ariaInvalid(form.Errors["date_format"])}) {
				for _, f := range dateFormats {
					@nativeselect.Option(nativeselect.OptionProps{Value: f.Value, Selected: f.Value == form.DateFormat}) {
						{ i18n.T(ctx, "date_format."+f.Value) }
					}
				}
			}
		}
		@formField("number_format", i18n.T(ctx, "settings.number_format"), form.Errors["number_format"]) {
			@nativeselect.NativeSelect(nativeselect.Props{ID: "number_format", Name: "number_format", Class: "w-full", Attributes: ariaInvalid(form.Errors["number_format"])}) {
				for _, f := range numberFormats {
					@nativeselect.Option(nativeselect.OptionProps{Value: f.Value, Selected: f.Value == form.NumberFormat}) {
						{ f.Value }
					}
				}
			}
		}
		@formField("daily_limit_mode", i18n.T(ctx, "settings.daily_limit_mode"), form.Errors["daily_limit_mode"]) {
			@nativeselect.NativeSelect(nativeselect.Props{ID: "daily_limit_mode", Name: "daily_limit_mode", Class: "w-full", Attributes: ariaInvalid(form.Errors["daily_limit_mode"])}) {
				for _, m := range dailyLimitModes {
					@nativeselect.Option(nativeselect.OptionProps{Value: m.Value, Selected: m.Value == form.DailyLimitMode}) {
						{ i18n.T(ctx, "daily_limit_mode."+m.Value) }
					}
				}
			}
		}
		@formField("currency", i18n.T(ctx, "settings.currency"), form.Errors["currency"]) {
			@nativeselect.NativeSelect(nativeselect.Props{ID: "currency", Name: "currency", Class: "w-full", Attributes: ariaInvalid(form.Errors["currency"])}) {
				for _, c := range currencies {
					@nativeselect.Option(nativeselect.OptionProps{Value: c.Value, Selected: c.Value == form.Currency}) {
						{ c.Value + " (" + c.Symbol + ")" }
					}
				}
			}
			@field.Description() {
				{ i18n.T(ctx, "settings.currency_note") }
			}
		}
		if form.OpenFinance {
			@pluggyFields(form)
		}
	}
}

// pluggyFields are the user's Pluggy client id and secret, with "apagar credenciais" and its inline confirmation
// when they are saved.
templ pluggyFields(form settingsForm) {
	@hintField("pluggy_client_id", i18n.T(ctx, "settings.pluggy_client_id"), i18n.T(ctx, "settings.pluggy_hint"), form.Errors["pluggy_client_id"]) {
		@input.Input(input.Props{ID: "pluggy_client_id", Name: "pluggy_client_id", Value: form.PluggyClientID, Attributes: ariaInvalid(form.Errors["pluggy_client_id"], templ.Attributes{"autocomplete": "off"})})
	}
	@hintField("pluggy_client_secret", i18n.T(ctx, "settings.pluggy_client_secret"), secretHint(ctx, form.HasPluggy), form.Errors["pluggy_client_secret"]) {
		@input.Input(input.Props{ID: "pluggy_client_secret", Name: "pluggy_client_secret", Type: "password", Attributes: ariaInvalid(form.Errors["pluggy_client_secret"], templ.Attributes{"autocomplete": "off"})})
	}
	if form.HasPluggy {
		<div class="flex flex-wrap gap-2" data-confirm>
			@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantDestructive, Size: button.SizeSm, Attributes: templ.Attributes{"onclick": templ.JSUnsafeFuncCall(toggleConfirm), "data-focus": true}}) {
				{ i18n.T(ctx, "settings.pluggy_delete") }
			}
			@confirmInline(i18n.T(ctx, "settings.pluggy_confirm"), i18n.T(ctx, "sheet.confirm_delete"), templ.Attributes{"hx-delete": "/settings/pluggy", "hx-target": "#sheet"})
		</div>
	}
}
