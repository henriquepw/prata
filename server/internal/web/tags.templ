package web

import (
	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/table"
	"github.com/henriquepw/prata/server/internal/web/shared"
	"github.com/henriquepw/prata/server/internal/web/utils"
)

// tagForm is the tag sheet: what the user typed, dates as YYYY-MM-DD, and an error message per field name,
// "form" holding a rejected commit.
type tagForm struct {
	ID      string
	Name    string
	StartAt string
	EndAt   string
	Errors  map[string]string
}

templ tagsPage(s shell, tags []store.Tag) {
	{{ loc := s.Now.Location() }}
	@layout(s) {
		@panel(i18n.T(ctx, "nav.tags"), "", newAction("/tags/new")) {
			if len(tags) == 0 {
				@empty(i18n.T(ctx, "tags.empty"))
			} else {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head(table.HeadProps{Class: "w-full"}) {
								{ i18n.T(ctx, "field.name") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "tags.period") }
							}
						}
					}
					@table.Body() {
						for _, tag := range tags {
							@table.Row(sheetRow("/tags/"+tag.ID, tag.ID == s.Flash)) {
								@table.Cell() {
									{ "#" + tag.Name }
								}
								@table.Cell(table.CellProps{Class: "text-right tabular-nums text-muted-foreground"}) {
									if tag.EndAt == nil {
										{ i18n.T(ctx, "tags.since", shared.FormatDate(tag.StartAt, loc, shared.DateLayout(ctx))) }
									} else {
										{ i18n.T(ctx, "tags.between", shared.FormatDate(tag.StartAt, loc, shared.DateLayout(ctx)), shared.FormatDate(*tag.EndAt, loc, shared.DateLayout(ctx))) }
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

templ tagSheet(form tagForm) {
	@sheet(sheetProps{
		Title:     i18n.T(ctx, utils.IfElse(form.ID == "", "tags.new", "tags.edit")),
		Action:    utils.IfElse(form.ID == "", "/tags", "/tags/"+form.ID),
		DeleteURL: utils.IfElse(form.ID == "", "", "/tags/"+form.ID),
		Confirm:   i18n.T(ctx, "tags.confirm_delete"),
		Error:     form.Errors["form"],
	}) {
		@nameField(form.Name, form.Errors["name"])
		<div class="grid grid-cols-2 gap-4">
			@dateField("start_at", i18n.T(ctx, "field.start"), form.StartAt, form.Errors["start_at"])
			@endField(form.EndAt, form.Errors["end_at"])
		</div>
	}
}
