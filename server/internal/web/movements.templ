package web

import (
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/web/components/button"
	"github.com/henriquepw/prata/server/internal/web/components/input"
	"github.com/henriquepw/prata/server/internal/web/components/nativeselect"
	"github.com/henriquepw/prata/server/internal/web/components/table"
)

// movementsPage is the review screen: the "Importar arquivo" form over the list of pending movements.
templ movementsPage(s shell, view movementsView) {
	@layout(s) {
		@importPanel(view)
		@movementsPanel(view)
	}
}

// importPanel is the form that sends one file to one of the user's accounts, with the summary or the error of the
// last import under it. A response, a 422 included, swaps the screen's main.
templ importPanel(view movementsView) {
	@panel(i18n.T(ctx, "movements.import"), "", nil) {
		<form id="import-form" hx-post="/movements/import" hx-encoding="multipart" hx-target="main" hx-select="main" hx-swap="outerHTML" hx-disable="find [type=submit]" class="flex flex-wrap items-end gap-[2ch]">
			<input type="hidden" name="confirm_currency"/>
			@hintField("file", i18n.T(ctx, "movements.file"), i18n.T(ctx, "movements.file_hint"), view.Error) {
				@input.Input(input.Props{ID: "file", Name: "file", Type: "file", Required: true, Attributes: ariaInvalid(view.Error)})
			}
			@formField("account_id", i18n.T(ctx, "movements.account"), "") {
				@nativeselect.NativeSelect(nativeselect.Props{ID: "account_id", Name: "account_id"}) {
					for _, account := range view.Accounts {
						@nativeselect.Option(nativeselect.OptionProps{Value: account.ID}) {
							{ account.Name }
						}
					}
				}
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"data-busy": i18n.T(ctx, "movements.importing")}}) {
				<span>&gt; { i18n.T(ctx, "movements.import_submit") }</span>
			}
		</form>
		if view.Summary != "" {
			<p role="status" class="text-xs text-muted-foreground">{ view.Summary }</p>
		}
	}
}

// currencyDialog asks, in #sheet, to import a file whose Moeda is not the Conta's: confirming resubmits the import
// form, whose file input still holds the file, with confirm_currency set.
templ currencyDialog(v currencyView) {
	<div id="currency-dialog" class="panel sheet-panel">
		<header class="panel-head">
			<h2 class="panel-title">{ i18n.T(ctx, "movements.currency.title") }</h2>
			<button type="button" class="lnk" aria-label={ i18n.T(ctx, "sheet.close") } onclick={ templ.JSUnsafeFuncCall(closeSheet) }>[esc ✕]</button>
		</header>
		<p class="text-xs">{ i18n.T(ctx, "movements.currency.body", v.File, v.Account) }</p>
		<footer class="mt-auto flex flex-wrap justify-end gap-[1ch]">
			@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Attributes: templ.Attributes{"onclick": templ.JSUnsafeFuncCall(closeSheet)}}) {
				{ i18n.T(ctx, "sheet.cancel") }
			}
			@button.Button(button.Props{Type: button.TypeButton, Attributes: templ.Attributes{"data-focus": true, "onclick": templ.JSUnsafeFuncCall(confirmCurrency)}}) {
				<span>&gt; { i18n.T(ctx, "movements.currency.confirm") }</span>
			}
		</footer>
	</div>
}

const confirmCurrency = "const f = document.getElementById('import-form'); f.elements.confirm_currency.value = '1'; this.closest('dialog').close(); f.requestSubmit()"

// movementsPanel lists the pending movements.
templ movementsPanel(view movementsView) {
	@panel(i18n.T(ctx, "nav.movements"), "", nil) {
		if len(view.Movements) == 0 {
			@empty(i18n.T(ctx, "movements.empty"))
		} else {
			@batchForm(view.Categories)
			@table.Table() {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							<input type="checkbox" aria-label={ i18n.T(ctx, "movements.select_all") } onclick={ templ.JSUnsafeFuncCall(selectAll) }/>
						}
						@table.Head() {
							{ i18n.T(ctx, "field.date") }
						}
						@table.Head(table.HeadProps{Class: "w-full"}) {
							{ i18n.T(ctx, "field.description") }
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							{ i18n.T(ctx, "field.amount") }
						}
						@table.Head(table.HeadProps{Class: "hide-m"}) {
							{ i18n.T(ctx, "kind.label") }
						}
						@table.Head(table.HeadProps{Class: "hide-m"}) {
							{ i18n.T(ctx, "movements.bank_account") }
						}
						@table.Head() {
							{ i18n.T(ctx, "movements.review") }
						}
					}
				}
				@table.Body() {
					for _, m := range view.Movements {
						@table.Row() {
							@table.Cell() {
								<input type="checkbox" form="batch" name="id" value={ m.ID } aria-label={ m.Description }/>
							}
							@table.Cell(table.CellProps{Class: "tabular-nums text-muted-foreground"}) {
								{ movementDate(ctx, m.OccurredAt) }
							}
							@table.Cell(table.CellProps{Class: "whitespace-normal"}) {
								{ m.Description }
							}
							@table.Cell(table.CellProps{Class: "text-right tabular-nums " + kindClass(m.Kind)}) {
								{ money(ctx, signed(m.Kind, m.Amount)) }
							}
							@table.Cell(table.CellProps{Class: "hide-m"}) {
								{ i18n.T(ctx, "kind."+m.Kind) }
							}
							@table.Cell(table.CellProps{Class: "hide-m text-muted-foreground"}) {
								{ i18n.T(ctx, "movements.kind."+m.BankAccountKind) } { m.Institution } { m.BankAccount }
							}
							@table.Cell() {
								@reviewForm(m, view.Categories)
							}
						}
					}
				}
			}
		}
	}
}

// reviewForm confirms a movement as a transaction, editing only its description and, for an expense, its category
// (the default one is preselected), or ignores it. A response swaps the screen's main.
templ reviewForm(m store.Movement, categories []store.Category) {
	<form hx-post={ "/movements/" + m.ID + "/confirm" } hx-target="main" hx-select="main" hx-swap="outerHTML" hx-disable="find button" class="flex flex-wrap items-center gap-[1ch]">
		@input.Input(input.Props{Name: "description", Value: m.Description, Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "field.description")}})
		if m.Kind == "OUTCOME" {
			@nativeselect.NativeSelect(nativeselect.Props{Name: "category_id", Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "field.category")}}) {
				for _, category := range categories {
					@nativeselect.Option(nativeselect.OptionProps{Value: category.ID, Selected: category.IsDefault}) {
						{ category.Name }
					}
				}
			}
		}
		@button.Button(button.Props{Type: button.TypeSubmit}) {
			<span>&gt; { i18n.T(ctx, "movements.confirm") }</span>
		}
		@button.Button(button.Props{Variant: button.VariantGhost, Attributes: templ.Attributes{"hx-post": "/movements/" + m.ID + "/ignore", "hx-target": "main", "hx-select": "main", "hx-swap": "outerHTML"}}) {
			<span>{ i18n.T(ctx, "movements.ignore") }</span>
		}
	</form>
}

const selectAll = "for (const c of document.querySelectorAll('input[form=batch][name=id]')) c.checked = this.checked"

// batchForm confirms or ignores the checked movements, which carry form="batch" from their rows. The category
// (the default one is preselected) goes to the expenses; incomes keep none. A response swaps the screen's main.
templ batchForm(categories []store.Category) {
	<form id="batch" hx-target="main" hx-select="main" hx-swap="outerHTML" hx-disable="find button" class="mb-2 flex flex-wrap items-center gap-[1ch]">
		@nativeselect.NativeSelect(nativeselect.Props{Name: "category_id", Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "field.category")}}) {
			for _, category := range categories {
				@nativeselect.Option(nativeselect.OptionProps{Value: category.ID, Selected: category.IsDefault}) {
					{ category.Name }
				}
			}
		}
		@button.Button(button.Props{Type: button.TypeButton, Attributes: templ.Attributes{"hx-post": "/movements/confirm"}}) {
			<span>&gt; { i18n.T(ctx, "movements.confirm_selected") }</span>
		}
		@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantGhost, Attributes: templ.Attributes{"hx-post": "/movements/ignore"}}) {
			<span>{ i18n.T(ctx, "movements.ignore_selected") }</span>
		}
	</form>
}
