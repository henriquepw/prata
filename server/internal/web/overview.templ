package web

import (
	"strconv"
	"time"

	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/badge"
	"github.com/henriquepw/prata/server/internal/web/components/button"
	"github.com/henriquepw/prata/server/internal/web/components/table"
	"github.com/henriquepw/prata/server/internal/web/utils"
)

// money writes signed cents as a pt-BR amount such as "−R$ 1.234,56".
func money(cents int64) string {
	if cents < 0 {
		return "−R$ " + formatCents(-cents)
	}

	return "R$ " + formatCents(cents)
}

const meterSegments = 20

// meter is the class of each of the 20 segments of a category's usage: the used share of the limit in the category's
// color and, past the limit, the limit's share in color (19 at most) and the excess "over"; all empty without a limit.
func meter(usage store.CategoryUsage) []string {
	segments := make([]string, meterSegments)
	if usage.MonthlyLimit == 0 {
		return segments
	}

	isOver := usage.Used > usage.MonthlyLimit
	on := (usage.Used*meterSegments + usage.MonthlyLimit/2) / usage.MonthlyLimit
	if isOver {
		on = min(meterSegments-1, (usage.MonthlyLimit*meterSegments+usage.Used/2)/usage.Used)
	}

	for i := range segments {
		switch {
		case int64(i) < on:
			segments[i] = colorClass(usage.Color)
		case isOver:
			segments[i] = "over"
		}
	}

	return segments
}

// percent is the rounded share of the limit a category used, or "∞" without a limit.
func percent(usage store.CategoryUsage) string {
	if usage.MonthlyLimit == 0 {
		return "∞"
	}

	return strconv.FormatInt((usage.Used*100+usage.MonthlyLimit/2)/usage.MonthlyLimit, 10) + "%"
}

// tightTable narrows a wide table's cell padding on mobile, spelled out here for Tailwind.
const tightTable = "@max-[640px]:[&_:is(td,th)]:px-1"

// shortDate writes a pure "YYYY-MM-DD" date as "DD/MM/YYYY".
func shortDate(date string) string {
	t, _ := time.Parse(time.DateOnly, date)

	return t.Format(brDate)
}

// homePage lays the KPI strip, Pendentes and Uso por categoria in the main column and the activity log down the
// right, or last on mobile.
templ homePage(s shell, page overview) {
	{{ month := monthNames[page.Month.Month()-1][:3] }}
	@layout(s) {
		<div class="overview">
			<div class="kpis">
				@kpi("Saldo realizado", s.Balance.Realized)
				@kpi("Saldo projetado", s.Balance.Projected)
				@kpi("Entradas "+month, page.Income)
				@kpi("Saídas "+month, -page.Outcome)
			</div>
			@panel("Pendentes", "", nil) {
				if page.Error != "" {
					<p role="alert" class="mb-[1lh] text-destructive">! { page.Error }</p>
				}
				if len(s.Balance.Pending) == 0 {
					@empty("nenhuma ocorrência pendente")
				} else {
					@table.Table(table.Props{Class: tightTable}) {
						@table.Header() {
							@table.Row() {
								@table.Head() {
									Data
								}
								@table.Head(table.HeadProps{Class: "w-full"}) {
									Descrição
								}
								@table.Head(table.HeadProps{Class: "text-right"}) {
									Valor
								}
								@table.Head() {
									<span class="sr-only">Ação</span>
								}
							}
						}
						@table.Body() {
							for _, pending := range s.Balance.Pending {
								@table.Row() {
									@table.Cell(table.CellProps{Class: utils.CN("tabular-nums", utils.IfElse(pending.Overdue, "text-destructive", ""))}) {
										{ shortDate(pending.Date) }
									}
									@table.Cell(table.CellProps{Class: "whitespace-normal"}) {
										{ orEmpty(pending.Recurrence.Description) }
										if pending.Overdue {
											@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
												[atrasada]
											}
										} else {
											@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
												[pendente]
											}
										}
									}
									@table.Cell(table.CellProps{Class: utils.CN("text-right tabular-nums", kindClass(pending.Recurrence.Kind))}) {
										{ money(signed(pending.Recurrence.Kind, pending.Recurrence.Amount)) }
									}
									@table.Cell(table.CellProps{Class: "text-right"}) {
										<form method="post" action={ templ.SafeURL("/recurrences/" + pending.Recurrence.ID + "/occurrences/" + pending.Date) }>
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
												confirmar
											}
										</form>
									}
								}
							}
						}
					}
				}
			}
			@panel("Uso por categoria", "", nil) {
				if len(page.Usages) == 0 {
					@empty("nenhuma categoria ainda")
				} else {
					<ul class="usages">
						for _, usage := range page.Usages {
							<li>
								<div class="usage-name">{ usage.Name }</div>
								<div class="usage-meter">
									<div class="meter" aria-hidden="true">
										for _, segment := range meter(usage) {
											<i class={ segment }></i>
										}
									</div>
									<b class={ templ.KV("text-destructive", usage.MonthlyLimit > 0 && usage.Used > usage.MonthlyLimit) }>{ percent(usage) }</b>
								</div>
								<div class="text-xs text-muted-foreground tabular-nums">
									if usage.MonthlyLimit > 0 {
										{ money(usage.Used) + " / " + money(usage.MonthlyLimit) }
									} else {
										{ money(usage.Used) } · sem limite
									}
								</div>
							</li>
						}
					</ul>
				}
			}
			@activityLog(page.Activity, s.Now.Location())
		</div>
	}
}
