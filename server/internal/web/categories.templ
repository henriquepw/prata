package web

import (
	"strings"

	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/web/utils"
)

// categoryColor is a schema color, whose label is the i18n key "color." + Value, and its text color class, spelled
// out here for Tailwind.
type categoryColor struct {
	option
	Class string
}

var categoryColors = []categoryColor{
	{option{"GRAY"}, "text-cat-gray"},
	{option{"RED"}, "text-cat-red"},
	{option{"YELLOW"}, "text-cat-yellow"},
	{option{"BLUE"}, "text-cat-blue"},
	{option{"GREEN"}, "text-cat-green"},
}

// categoryForm is the category sheet: what the user typed and an error message per field name,
// "form" holding a rejected commit.
type categoryForm struct {
	ID          string
	Name        string
	Color       string
	IsDaily     bool
	IsDefault   bool
	MarkDefault bool
	Errors      map[string]string
}

// categoriesPage is the Categorias screen, which is the division of the Receita mensal (budgetScreen).
templ categoriesPage(s shell, form budgetForm) {
	@layout(s) {
		@budgetScreen(form, s.Flash)
	}
}

// categoryName is a category's name after its "■" in the category color.
templ categoryName(name, color string) {
	<span class="flex items-center gap-2"><span class={ colorClass(color) } aria-hidden="true">■</span>{ name }</span>
}

templ categorySheet(form categoryForm) {
	@sheet(sheetProps{
		Title:     i18n.T(ctx, utils.IfElse(form.ID == "", "categories.new", "categories.edit")),
		Action:    utils.IfElse(form.ID == "", "/categories", "/categories/"+form.ID),
		DeleteURL: utils.IfElse(form.ID == "" || form.IsDefault, "", "/categories/"+form.ID),
		Confirm:   i18n.T(ctx, "categories.confirm_delete"),
		Error:     form.Errors["form"],
	}) {
		@nameField(form.Name, form.Errors["name"])
		@choiceField("color", i18n.T(ctx, "categories.color"), "", form.Errors["color"]) {
			for _, color := range categoryColors {
				@choiceOption("color", color.Value, color.Value == form.Color) {
					<span class={ color.Class } aria-hidden="true">■</span> { strings.ToLower(i18n.T(ctx, "color."+color.Value)) }
				}
			}
		}
		@choiceField("is_daily", i18n.T(ctx, "categories.daily"), i18n.T(ctx, "categories.daily_help"), "") {
			@choiceOption("is_daily", "1", form.IsDaily) {
				{ i18n.T(ctx, "categories.yes") }
			}
			@choiceOption("is_daily", "0", !form.IsDaily) {
				{ i18n.T(ctx, "categories.no") }
			}
		}
		<fieldset class="contents" disabled?={ form.IsDefault }>
			@choiceField("is_default", i18n.T(ctx, "categories.default"), i18n.T(ctx, "categories.default_help"), "") {
				@choiceOption("is_default", "1", form.IsDefault || form.MarkDefault) {
					{ i18n.T(ctx, "categories.yes") }
				}
				@choiceOption("is_default", "0", !form.IsDefault && !form.MarkDefault) {
					{ i18n.T(ctx, "categories.no") }
				}
			}
		</fieldset>
	}
}
