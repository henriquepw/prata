package web

import (
	"strings"

	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/button"
	"github.com/henriquepw/prata/server/internal/web/components/input"
	"github.com/henriquepw/prata/server/internal/web/components/table"
	"github.com/henriquepw/prata/server/internal/web/utils"
)

// categoryColor is a schema color, whose label is the i18n key "color." + Value, and its text color class, spelled
// out here for Tailwind.
type categoryColor struct {
	option
	Class string
}

var categoryColors = []categoryColor{
	{option{"GRAY"}, "text-cat-gray"},
	{option{"RED"}, "text-cat-red"},
	{option{"YELLOW"}, "text-cat-yellow"},
	{option{"BLUE"}, "text-cat-blue"},
	{option{"GREEN"}, "text-cat-green"},
}

// categoryForm is the category sheet: what the user typed and an error message per field name,
// "form" holding a rejected commit.
type categoryForm struct {
	ID           string
	Name         string
	Color        string
	MonthlyLimit string
	IsDaily      bool
	IsDefault    bool
	MarkDefault  bool
	Errors       map[string]string
}

templ categoriesPage(s shell, categories []store.Category) {
	@layout(s) {
		@panel(i18n.T(ctx, "nav.categories"), "", categoriesActions()) {
			if len(categories) == 0 {
				@empty(i18n.T(ctx, "categories.empty"))
			} else {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head(table.HeadProps{Class: "w-full"}) {
								{ i18n.T(ctx, "field.name") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "categories.monthly_limit") }
							}
						}
					}
					@table.Body() {
						for _, category := range categories {
							@table.Row(sheetRow("/categories/"+category.ID, category.ID == s.Flash)) {
								@table.Cell() {
									@categoryName(category.Name, category.Color)
								}
								@table.Cell(table.CellProps{Class: "text-right tabular-nums text-muted-foreground"}) {
									if category.MonthlyLimit == 0 {
										{ i18n.T(ctx, "categories.no_limit") }
									} else {
										{ money(ctx, category.MonthlyLimit) }
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

// categoriesActions are the categories panel's "dividir receita" and "+ nova [n]".
templ categoriesActions() {
	<span class="flex gap-[1ch]">
		@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"hx-get": "/budget", "hx-target": "#sheet"}}) {
			{ i18n.T(ctx, "budget.open") }
		}
		@newAction("/categories/new")
	</span>
}

// categoryName is a category's name after its "■" in the category color.
templ categoryName(name, color string) {
	<span class="flex items-center gap-[1ch]"><span class={ colorClass(color) } aria-hidden="true">■</span>{ name }</span>
}

templ categorySheet(form categoryForm) {
	@sheet(sheetProps{
		Title:     i18n.T(ctx, utils.IfElse(form.ID == "", "categories.new", "categories.edit")),
		Action:    utils.IfElse(form.ID == "", "/categories", "/categories/"+form.ID),
		DeleteURL: utils.IfElse(form.ID == "" || form.IsDefault, "", "/categories/"+form.ID),
		Confirm:   i18n.T(ctx, "categories.confirm_delete"),
		Error:     form.Errors["form"],
	}) {
		@nameField(form.Name, form.Errors["name"])
		@choiceField("color", i18n.T(ctx, "categories.color"), form.Errors["color"]) {
			for _, color := range categoryColors {
				@choiceOption("color", color.Value, color.Value == form.Color) {
					<span class={ color.Class } aria-hidden="true">■</span> { strings.ToLower(i18n.T(ctx, "color."+color.Value)) }
				}
			}
		}
		@choiceField("is_daily", i18n.T(ctx, "categories.daily"), "") {
			@choiceOption("is_daily", "1", form.IsDaily) {
				{ i18n.T(ctx, "categories.yes") }
			}
			@choiceOption("is_daily", "0", !form.IsDaily) {
				{ i18n.T(ctx, "categories.no") }
			}
		}
		if !form.IsDefault {
			@choiceField("is_default", i18n.T(ctx, "categories.default"), "") {
				@choiceOption("is_default", "1", form.MarkDefault) {
					{ i18n.T(ctx, "categories.yes") }
				}
				@choiceOption("is_default", "0", !form.MarkDefault) {
					{ i18n.T(ctx, "categories.no") }
				}
			}
		}
		if sessionFrom(ctx).MonthlyIncome == 0 {
			@hintField("monthly_limit", i18n.T(ctx, "categories.monthly_limit"), i18n.T(ctx, "categories.monthly_limit_hint"), form.Errors["monthly_limit"]) {
				@currencyPrefix() {
					@input.Input(input.Props{ID: "monthly_limit", Name: "monthly_limit", Value: form.MonthlyLimit, Placeholder: amount(ctx, 0), Class: "tabular-nums", Attributes: ariaInvalid(form.Errors["monthly_limit"])})
				}
			}
		}
	}
}
