package web

import (
	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/console"
	"github.com/henriquepw/prata/server/internal/web/components/input"
	"github.com/henriquepw/prata/server/internal/web/components/nativeselect"
	"github.com/henriquepw/prata/server/internal/web/utils"
)

// transactionForm is the transaction sheet: what the user typed, the date as YYYY-MM-DD, the live categories
// and tags to pick from and an error message per field name, "form" holding a rejected commit.
type transactionForm struct {
	ID          string
	Description string
	Kind        string
	Amount      string
	OccurredAt  string
	CategoryID  string
	TagID       string
	Categories  []store.Category
	Tags        []store.Tag
	Errors      map[string]string
}

templ transactionSheet(form transactionForm) {
	@console.Sheet(console.SheetProps{
		Title:     i18n.T(ctx, utils.IfElse(form.ID == "", "transactions.new", "transactions.edit")),
		Action:    utils.IfElse(form.ID == "", "/transactions", "/transactions/"+form.ID),
		DeleteURL: utils.IfElse(form.ID == "", "", "/transactions/"+form.ID),
		Confirm:   i18n.T(ctx, "transactions.confirm_delete"),
		Error:     form.Errors["form"],
	}) {
		@console.KindChoice(form.Kind, form.Errors["kind"])
		@console.AmountField(form.Amount, "", form.Errors["amount"])
		@console.FormField("description", i18n.T(ctx, "field.description"), form.Errors["description"]) {
			@input.Input(input.Props{ID: "description", Name: "description", Value: form.Description})
		}
		<div class="grid grid-cols-2 gap-4">
			@console.DateField("occurred_at", i18n.T(ctx, "field.date"), form.OccurredAt, form.Errors["occurred_at"])
			@console.CategoryField(form.Categories, form.CategoryID, form.Errors["category_id"])
		</div>
		@console.FormField("tag_id", i18n.T(ctx, "field.tag"), form.Errors["tag_id"]) {
			@nativeselect.NativeSelect(nativeselect.Props{ID: "tag_id", Name: "tag_id", Class: "w-full", Attributes: console.AriaInvalid(form.Errors["tag_id"])}) {
				@nativeselect.Option(nativeselect.OptionProps{Value: "", Selected: form.TagID == ""}) {
					{ i18n.T(ctx, "field.no_tag") }
				}
				for _, tag := range form.Tags {
					@nativeselect.Option(nativeselect.OptionProps{Value: tag.ID, Selected: tag.ID == form.TagID}) {
						{ tag.Name }
					}
				}
			}
		}
	}
}
