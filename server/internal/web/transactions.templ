package web

import (
	"github.com/henriquepw/prata/server/internal/i18n"
	"github.com/henriquepw/prata/server/internal/store"
	"github.com/henriquepw/prata/server/internal/web/components/input"
	"github.com/henriquepw/prata/server/internal/web/components/nativeselect"
	"github.com/henriquepw/prata/server/internal/web/utils"
)

// transactionForm is the transaction sheet: what the user typed, the date as YYYY-MM-DD, the live categories
// and tags to pick from and an error message per field name, "form" holding a rejected commit.
type transactionForm struct {
	ID          string
	Description string
	Kind        string
	Amount      string
	OccurredAt  string
	CategoryID  string
	TagID       string
	Categories  []store.Category
	Tags        []store.Tag
	Errors      map[string]string
}

templ transactionSheet(form transactionForm) {
	@sheet(sheetProps{
		Title:     i18n.T(ctx, utils.IfElse(form.ID == "", "transactions.new", "transactions.edit")),
		Action:    utils.IfElse(form.ID == "", "/transactions", "/transactions/"+form.ID),
		DeleteURL: utils.IfElse(form.ID == "", "", "/transactions/"+form.ID),
		Confirm:   i18n.T(ctx, "transactions.confirm_delete"),
		Error:     form.Errors["form"],
	}) {
		@formField("description", i18n.T(ctx, "field.description"), form.Errors["description"]) {
			@input.Input(input.Props{ID: "description", Name: "description", Value: form.Description})
		}
		@formField("amount", i18n.T(ctx, "field.amount"), form.Errors["amount"]) {
			@currencyPrefix() {
				@input.Input(input.Props{ID: "amount", Name: "amount", Value: form.Amount, Placeholder: amount(ctx, 0), Required: true, Class: "tabular-nums", Attributes: ariaInvalid(form.Errors["amount"])})
			}
		}
		<div class="grid grid-cols-2 gap-[2ch]">
			@formField("occurred_at", i18n.T(ctx, "field.date"), form.Errors["occurred_at"]) {
				@input.Input(input.Props{ID: "occurred_at", Name: "occurred_at", Type: "date", Value: form.OccurredAt, Required: true, Attributes: ariaInvalid(form.Errors["occurred_at"])})
			}
			@formField("category_id", i18n.T(ctx, "field.category"), form.Errors["category_id"]) {
				@nativeselect.NativeSelect(nativeselect.Props{ID: "category_id", Name: "category_id", Class: "w-full", Attributes: ariaInvalid(form.Errors["category_id"])}) {
					@nativeselect.Option(nativeselect.OptionProps{Value: "", Selected: form.CategoryID == ""}) {
						{ i18n.T(ctx, "field.no_category") }
					}
					for _, category := range form.Categories {
						@nativeselect.Option(nativeselect.OptionProps{Value: category.ID, Selected: category.ID == form.CategoryID}) {
							{ category.Name }
						}
					}
				}
			}
		</div>
		@kindChoice(form.Kind, form.Errors["kind"])
		@formField("tag_id", i18n.T(ctx, "field.tag"), form.Errors["tag_id"]) {
			@nativeselect.NativeSelect(nativeselect.Props{ID: "tag_id", Name: "tag_id", Class: "w-full", Attributes: ariaInvalid(form.Errors["tag_id"])}) {
				@nativeselect.Option(nativeselect.OptionProps{Value: "", Selected: form.TagID == ""}) {
					{ i18n.T(ctx, "field.no_tag") }
				}
				for _, tag := range form.Tags {
					@nativeselect.Option(nativeselect.OptionProps{Value: tag.ID, Selected: tag.ID == form.TagID}) {
						{ tag.Name }
					}
				}
			}
		}
	}
}
